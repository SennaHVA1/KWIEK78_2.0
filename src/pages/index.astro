---
/**
 * De homepage.
 *
 * Volgorde is bewust: hero, eerstvolgende wedstrijd, nieuws, agenda,
 * verjaardagen, sponsoren. De hoofdgebruiker is een ouder die zaterdagochtend
 * om kwart over acht op de telefoon kijkt of de wedstrijd doorgaat. Daarom is
 * de hero op mobiel laag gehouden en staan er drie snelknoppen in beeld die
 * rechtstreeks naar het programma, de uitslagen en de diensten gaan.
 */
import Basis from '../layouts/Basis.astro';
import Foto from '../components/Foto.astro';
import EerstvolgendeWedstrijd from '../components/EerstvolgendeWedstrijd.astro';
import NieuwsKaart from '../components/NieuwsKaart.astro';
import AgendaLijst from '../components/AgendaLijst.astro';
import Verjaardagen from '../components/Verjaardagen.astro';
import SponsorCarousel from '../components/SponsorCarousel.astro';

import { getEerstvolgendeWedstrijden, getVerjaardagenDezeWeek } from '../lib/sportlink';
import { getLaatsteNieuws } from '../lib/nieuws';
import { getKomendeAgenda, getCarouselSponsoren } from '../lib/club';

const komendeWedstrijden = getEerstvolgendeWedstrijden('kwiek-78-1', 4);
const nieuws = getLaatsteNieuws(4);
const agenda = getKomendeAgenda(4);
const jarigen = getVerjaardagenDezeWeek();
const sponsoren = getCarouselSponsoren();

/* De drie dingen waarvoor mensen hier komen, meteen in beeld. */
const snelknoppen = [
  { label: 'Programma', uitleg: 'Wie speelt wanneer', href: '/wedstrijden/programma' },
  { label: 'Uitslagen', uitleg: 'Hoe is het afgelopen', href: '/wedstrijden/uitslagen' },
  { label: 'Diensten', uitleg: 'Wanneer ben ik aan de beurt', href: '/vrijwillige-diensten' },
];
---

<Basis
  titel="Home"
  omschrijving="Voetbalvereniging Kwiek '78 uit Avenhorn. Programma, uitslagen, standen, teams en clubnieuws op een plek."
>
  <!-- ================================================================== -->
  <!-- Hero                                                               -->
  <!-- ================================================================== -->
  <section class="hero vlak-zwart">
    <div class="hero-beeld" aria-hidden="true">
      <Foto
        src="/images/club/sfeer-veld.webp"
        alt=""
        ratio="4 / 3"
        prioriteit
        plaatshouder="club/sfeer-veld.webp"
      />
    </div>

    <div class="omhulsel hero-binnen">
      <p class="hero-boven">Avenhorn, sinds 1978</p>
      <h1 class="hero-titel">Kwiek '78</h1>
      <p class="hero-onder">
        Zwart-wit, elke zondag in de vijfde klasse. Ruim driehonderd leden en een kantine die open blijft.
      </p>
    </div>
  </section>

  <!-- Snelknoppen: de drie taken waarvoor mensen deze site openen. -->
  <nav class="snel vlak-zwart" aria-label="Snel naar">
    <div class="omhulsel">
      <ul class="snel-lijst">
        {snelknoppen.map((knop) => (
          <li>
            <a class="snelknop" href={knop.href}>
              <span class="snelknop-label">{knop.label}</span>
              <span class="snelknop-uitleg">{knop.uitleg}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- ================================================================== -->
  <!-- Eerstvolgende wedstrijd                                             -->
  <!-- ================================================================== -->
  <EerstvolgendeWedstrijd wedstrijden={komendeWedstrijden} />

  <div class="baan" aria-hidden="true"></div>

  <!-- ================================================================== -->
  <!-- Laatste nieuws                                                      -->
  <!-- ================================================================== -->
  <section class="vlak-wit sectie" aria-labelledby="nieuws-kop">
    <div class="omhulsel">
      <div class="sectiekop">
        <div>
          <p class="kolom-kicker">Uit de club</p>
          <h2 class="kop-sectie" id="nieuws-kop">Laatste nieuws</h2>
        </div>
        <a class="knop knop--rand" href="/nieuws">Alle berichten</a>
      </div>

      <div class="nieuwsraster">
        {nieuws.map((artikel, i) => (
          <div class="verschijn" style={`transition-delay:${i * 60}ms`}>
            <NieuwsKaart artikel={artikel} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Agenda en verjaardagen                                              -->
  <!-- ================================================================== -->
  <section class="vlak-papier sectie" aria-labelledby="agenda-kop">
    <div class="omhulsel tweeluik">
      <div>
        <div class="sectiekop">
          <div>
            <p class="kolom-kicker">Wat er nog komt</p>
            <h2 class="kop-sectie" id="agenda-kop">Agenda</h2>
          </div>
          <a class="knop knop--rand" href="/club/agenda">Hele agenda</a>
        </div>
        <AgendaLijst items={agenda} toonOmschrijving={false} />
      </div>

      <div>
        <div class="sectiekop">
          <div>
            <p class="kolom-kicker">Even feliciteren</p>
            <h2 class="kop-sectie" id="jarig-kop">Jarig deze week</h2>
          </div>
          <a class="knop knop--rand" href="/club/verjaardagen">Kalender</a>
        </div>
        <Verjaardagen leden={jarigen} />
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Hoofdsponsoren                                                      -->
  <!-- ================================================================== -->
  <section class="vlak-wit sponsors" aria-labelledby="sponsor-kop">
    <div class="omhulsel sponsors-kop">
      <h2 class="kop-s" id="sponsor-kop">Mede mogelijk gemaakt door</h2>
      <a class="knop knop--rand" href="/sponsoring">Sponsor worden</a>
    </div>
    <SponsorCarousel sponsoren={sponsoren} />
  </section>
</Basis>

<style>
  /* ------------------------------------------------------------------ */
  /* Hero                                                               */
  /* ------------------------------------------------------------------ */
  .hero {
    position: relative;
    display: grid;
    isolation: isolate;
    min-height: 44vh;
    min-height: 44dvh;
    align-content: end;
    padding-top: clamp(2rem, 6vw, 5rem);
  }
  @media (min-width: 1024px) {
    .hero { min-height: 60vh; min-height: 60dvh; padding-top: 6rem; }
  }

  .hero-beeld { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .hero-beeld :global(img),
  .hero-beeld :global(.foto-plek) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
    border-radius: 0 !important;
    object-fit: cover;
    /* De hero is een brede band uit een staande teamfoto. Met de standaard
       uitsnede in het midden begint het beeld pas onder de achterste rij en
       zie je alleen de koppen van de voorste. Deze waarde legt de band hoger,
       zodat beide rijen gezichten in beeld staan. */
    object-position: center 20%;
  }
  /* De verduistering zit vooral onderin, waar de tekst staat. Bovenin blijft
     het beeld grotendeels open, want daar staan de gezichten. De foto blijft
     in kleur: grijstinten maakten de hele site somber en dat is niet wat een
     voetbalclub is. */
  .hero-beeld::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      /* Een ovale schaduw die in de hoek linksonder begint, precies waar de
         tekst staat, en naar rechtsboven uitdooft. De hele band donkerder
         maken kon niet: de voorste rij spelers staat tussen 38% en 64% van de
         hero en die moet juist zichtbaar blijven. Zo blijft de rechterkant van
         de foto open en staat de tekst toch op een vaste donkere ondergrond. */
      radial-gradient(
        150% 120% at 0% 100%,
        color-mix(in srgb, var(--color-zwart) 78%, transparent) 0%,
        color-mix(in srgb, var(--color-zwart) 55%, transparent) 45%,
        transparent 78%
      ),
      linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-zwart) 16%, transparent) 0%,
      color-mix(in srgb, var(--color-zwart) 12%, transparent) 42%,
      color-mix(in srgb, var(--color-zwart) 52%, transparent) 66%,
      color-mix(in srgb, var(--color-zwart) 88%, transparent) 85%,
      color-mix(in srgb, var(--color-zwart) 97%, transparent) 100%
    );
  }

  /* De titel loopt met zijn bovenkant net over het lichtere deel van het
     verloop, en daar zitten witte shirts. Een zachte schaduw houdt de tekst
     leesbaar zonder dat de foto verder verduisterd hoeft te worden. */
  .hero-binnen > * {
    text-shadow: 0 2px 16px color-mix(in srgb, var(--color-zwart) 75%, transparent);
  }

  .hero-binnen { padding-bottom: clamp(1.5rem, 4vw, 2.5rem); }

  /* Wit, geen blauw. Op de hoogte van deze regel staat de verduistering op
     31% en is 23% van de foto daarachter lichter dan 180: dat zijn de witte
     shirts van de voorste rij. Blauw haalt daar 1,5:1 en wit 2,1:1, dus geen
     van beide is leesbaar zonder dat de ondergrond zelf donkerder wordt. Dat
     doet de scrim hieronder. Wit haalt daarmee ruim 8:1; blauw zou zelfs dan
     onder de 3,5:1 blijven, dus die kleur is hier gewoon verkeerd. Het accent
     blijft waar het hoort: aftelklok, uitslagen, actieve links. */
  .hero-boven {
    font-family: var(--font-smal);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-wit);
    margin-bottom: 0.5rem;
  }
  @media (min-width: 1024px) {
    .hero-boven { font-size: 0.875rem; }
  }
  .hero-titel {
    font-size: var(--text-kop-xl);
    line-height: 0.85;
  }
  .hero-onder {
    margin-top: 0.9rem;
    max-width: 42ch;
    font-size: var(--text-groot);
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-wit) 88%, transparent);
  }

  /* ------------------------------------------------------------------ */
  /* Snelknoppen                                                        */
  /* ------------------------------------------------------------------ */
  .snel { padding-bottom: clamp(1.5rem, 3vw, 2rem); }
  /* Let op: deze lijst zit in een aparte .omhulsel en is er niet zelf een.
     Scoped stijlen van Astro staan buiten de cascade-layers en winnen dus van
     .omhulsel in @layer components. Zet je hier 'margin: 0' op hetzelfde
     element, dan sneuvelt de centrering van de container. */
  .snel-lijst {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: 1fr;
    list-style: none;
  }
  @media (min-width: 620px) { .snel-lijst { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .snelknop {
    display: grid;
    gap: 0.05rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-vlak);
    background: var(--kleur-inkt);
    text-decoration: none;
    color: var(--color-wit);
    transition: background-color 0.18s var(--ease-klap);
  }
  .snelknop:hover { background: var(--color-blauwdiep); }
  @media (prefers-reduced-motion: reduce) { .snelknop { transition: none; } }

  .snelknop-label { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.1; }
  .snelknop-uitleg { font-size: var(--text-klein); color: var(--color-grijs); }
  .snelknop:hover .snelknop-uitleg { color: color-mix(in srgb, var(--color-wit) 85%, transparent); }

  /* ------------------------------------------------------------------ */
  /* Secties                                                            */
  /* ------------------------------------------------------------------ */
  .sectiekop {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.5rem;
  }

  .nieuwsraster {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .nieuwsraster { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .nieuwsraster { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .tweeluik { display: grid; gap: 3rem; }
  @media (min-width: 900px) {
    .tweeluik { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 3.5rem; }
  }

  .sponsors { padding-block: clamp(2.5rem, 4vw, 3.5rem); }
  .sponsors-kop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.25rem;
  }
</style>
