---
/**
 * De hoofdnavigatie.
 *
 * Twee niveaus, meer niet. Op desktop een enkele regel met uitklapmenu's,
 * onder 1280 pixels een schermvullend overlaymenu waarin alle groepen
 * openstaan. Geen accordeon in een accordeon: op mobiel scroll je door een
 * platte lijst en zie je in een oogopslag waar alles staat.
 */
import { MENU, isActief } from '../lib/menu';

const pad = Astro.url.pathname;
---

<header class="kop">
  <div class="omhulsel kop-binnen">
    {/* Het logo staat rechtstreeks op het zwart, zonder tegel eronder. Dat kan
        omdat het bestand is opgebouwd uit opake witte vlakken met zwarte
        lijnen erin: de bal en de banier blijven daardoor kloppen op een
        donkere ondergrond. Een omgekeerde variant klapt de panelen van de bal
        om en is dus niet nodig en niet gewenst.

        De naam staat in het logo zelf, dus die staat er niet nog een keer
        naast; hij zit in de alt-tekst zodat hij voor schermlezers en
        zoekmachines wel meetelt. */}
    <a class="merknaam" href="/">
      <img src="/images/logos/kwiek-78.png" alt="v.v. Kwiek '78, naar de homepage" width="512" height="300" />
    </a>

    <nav class="hoofdmenu" aria-label="Hoofdmenu">
      <ul class="hoofdmenu-lijst">
        {MENU.map((groep) => {
          const actief = isActief(pad, groep);
          return (
            <li class:list={['hoofdmenu-item', groep.kinderen && 'heeft-submenu']}>
              {groep.kinderen ? (
                <>
                  <button
                    type="button"
                    class:list={['hoofdmenu-knop', actief && 'is-actief']}
                    aria-expanded="false"
                    data-uitklap
                  >
                    {groep.label}
                    <svg class="pijl" width="9" height="6" viewBox="0 0 9 6" aria-hidden="true">
                      <path d="M1 1l3.5 3.5L8 1" fill="none" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </button>
                  <div class="submenu" hidden>
                    <ul>
                      {groep.kinderen.map((kind) => (
                        <li>
                          <a href={kind.href} class:list={[pad.replace(/\/$/, '') === kind.href.replace(/\/$/, '') && 'is-actief']}>
                            <span class="submenu-label">{kind.label}</span>
                            {kind.omschrijving && <span class="submenu-uitleg">{kind.omschrijving}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </>
              ) : (
                <a
                  class:list={['hoofdmenu-knop', actief && 'is-actief']}
                  href={groep.href}
                  target={groep.extern ? '_blank' : undefined}
                  rel={groep.extern ? 'noopener noreferrer' : undefined}
                >
                  {groep.label}
                  {groep.extern && (
                    <svg class="extern" width="9" height="9" viewBox="0 0 9 9" aria-hidden="true">
                      <path d="M2 7L7 2M7 2H3.2M7 2v3.8" fill="none" stroke="currentColor" stroke-width="1.4" />
                    </svg>
                  )}
                  {groep.extern && <span class="alleen-schermlezer">Opent in een nieuw tabblad</span>}
                </a>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <button type="button" class="hamburger" aria-expanded="false" aria-controls="overlaymenu" data-overlay-open>
      <span class="hamburger-streepjes" aria-hidden="true"><span></span><span></span></span>
      <span class="hamburger-tekst">Menu</span>
    </button>
  </div>
</header>

<!-- Schermvullend menu voor telefoon en tablet. -->
<div class="overlay" id="overlaymenu" hidden data-overlay>
  <div class="overlay-kop omhulsel">
    <span class="overlay-titel">Menu</span>
    <button type="button" class="overlay-sluit" data-overlay-close>
      <span aria-hidden="true">Sluiten</span>
      <span class="alleen-schermlezer">Menu sluiten</span>
    </button>
  </div>

  <nav class="overlay-inhoud omhulsel" aria-label="Menu">
    {MENU.map((groep) => (
      <section class="overlay-groep">
        {groep.kinderen ? (
          <>
            {/* Geen h2: het overlaymenu staat in de bron boven de h1 van de
                pagina, en dan zou de kopstructuur niet meer kloppen. Het is
                een groepslabel, dus dat hoort het ook te zijn. */}
            <p class="overlay-groepkop" id={`overlaygroep-${groep.label.toLowerCase().replace(/\s+/g, '-')}`}>
              {groep.label}
            </p>
            <ul aria-labelledby={`overlaygroep-${groep.label.toLowerCase().replace(/\s+/g, '-')}`}>
              {groep.kinderen.map((kind) => (
                <li>
                  <a href={kind.href} class:list={[pad.replace(/\/$/, '') === kind.href.replace(/\/$/, '') && 'is-actief']}>
                    {kind.label}
                  </a>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <a
            class:list={['overlay-enkel', isActief(pad, groep) && 'is-actief']}
            href={groep.href}
            target={groep.extern ? '_blank' : undefined}
            rel={groep.extern ? 'noopener noreferrer' : undefined}
          >
            {groep.label}
            {groep.extern && (
              <svg class="extern" width="11" height="11" viewBox="0 0 9 9" aria-hidden="true">
                <path d="M2 7L7 2M7 2H3.2M7 2v3.8" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
            )}
          </a>
        )}
      </section>
    ))}
  </nav>
</div>

<style>
  /* ------------------------------------------------------------------ */
  /* Balk                                                               */
  /* ------------------------------------------------------------------ */
  .kop {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-zwart);
    border-bottom: 1px solid var(--kleur-lijn-donker);
  }
  .kop-binnen {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 72px;
  }
  @media (min-width: 1280px) {
    .kop-binnen { min-height: 82px; }
  }

  .merknaam {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--color-wit);
    flex: none;
  }
  /* Het logo is een banier met de clubnaam erin, dus het moet groot genoeg
     staan om die naam te kunnen lezen. De hoogte van de balk is daarop
     afgestemd en niet andersom. */
  .merknaam img { width: 96px; height: auto; }
  @media (min-width: 1280px) {
    .merknaam img { width: 112px; }
  }

  /* ------------------------------------------------------------------ */
  /* Menu op desktop                                                    */
  /* ------------------------------------------------------------------ */
  .hoofdmenu { display: none; }
  @media (min-width: 1280px) { .hoofdmenu { display: block; } }

  .hoofdmenu-lijst {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hoofdmenu-item { position: relative; }

  .hoofdmenu-knop {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--color-wit);
    font-family: var(--font-smal);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.015em;
    text-decoration: none;
    padding: 0.5rem 0.7rem;
    white-space: nowrap;
    border-radius: var(--radius-klein);
    border-bottom: 0;
    transition: color 0.15s var(--ease-klap), border-color 0.15s var(--ease-klap);
  }
  .hoofdmenu-knop:hover { color: var(--color-blauw); }
  .hoofdmenu-knop.is-actief {
    color: var(--color-zwart);
    background: var(--color-wit);
  }
  .pijl, .extern { flex: none; opacity: 0.65; }
  [aria-expanded="true"] .pijl { transform: rotate(180deg); }

  .submenu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 16rem;
    background: var(--kleur-inkt);
    border-radius: var(--radius-vlak);
    padding: 0.5rem;
    z-index: 50;
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.35);
  }
  /* Brug over de ruimte tussen de knop en het paneel. Die ruimte hoort bij
     geen van beide elementen, dus zonder deze strook verlaat de aanwijzer het
     menu-item onderweg en sluit het paneel zich voor je er bent. */
  .submenu::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -0.6rem;
    height: 0.6rem;
  }
  .submenu[hidden] { display: none; }
  .submenu ul { list-style: none; margin: 0; padding: 0; }
  .submenu a {
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.7rem;
    text-decoration: none;
    color: var(--color-wit);
  }
  .submenu a { border-radius: var(--radius-klein); }
  .submenu a:hover { background: var(--kleur-inkt-op); }
  .submenu a.is-actief { color: var(--color-blauw); }
  .submenu-label { font-size: 1rem; font-weight: 600; }
  .submenu-uitleg { font-size: var(--text-mini); color: var(--color-grijs); }

  /* ------------------------------------------------------------------ */
  /* Hamburger                                                          */
  /* ------------------------------------------------------------------ */
  .hamburger {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: none;
    border: 0;
    background: var(--color-blauw);
    color: var(--color-zwart);
    cursor: pointer;
    padding: 0.6rem 0.95rem;
    border-radius: var(--radius-klein);
    font-family: var(--font-smal);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hamburger:hover { background: var(--color-wit); }
  @media (min-width: 1280px) { .hamburger { display: none; } }

  .hamburger-streepjes { display: grid; gap: 4px; width: 16px; }
  .hamburger-streepjes span { display: block; height: 2px; background: currentColor; }

  /* ------------------------------------------------------------------ */
  /* Overlaymenu                                                        */
  /* ------------------------------------------------------------------ */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-zwart);
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
  }
  .overlay[hidden] { display: none; }

  .overlay-kop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    border-bottom: 1px solid var(--kleur-lijn-donker);
    flex: none;
    position: sticky;
    top: 0;
    background: var(--color-zwart);
  }
  .overlay-titel {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-wit);
  }
  .overlay-sluit {
    background: var(--kleur-inkt-op);
    border: 0;
    border-radius: var(--radius-klein);
    color: var(--color-wit);
    cursor: pointer;
    padding: 0.6rem 0.95rem;
    font-family: var(--font-smal);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .overlay-inhoud { padding-block: 1.75rem 4rem; display: grid; gap: 1.75rem; }
  .overlay-groep ul { list-style: none; margin: 0; padding: 0; }

  .overlay-groepkop {
    font-family: var(--font-smal);
    font-size: var(--text-mini);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-blauw);
    margin-bottom: 0.4rem;
  }
  .overlay-groep a {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0;
    text-decoration: none;
    color: var(--color-wit);
    font-family: var(--font-smal);
    font-size: 1.35rem;
    font-weight: 600;
  }
  .overlay-groep a.is-actief { color: var(--color-blauw); }
  .overlay-enkel {
    font-family: var(--font-display) !important;
    font-size: 1.6rem !important;
    font-weight: 400 !important;
  }

  .alleen-schermlezer {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .hoofdmenu-knop { transition: none; }
  }
</style>

<script>
  /* ------------------------------------------------------------------ */
  /* Uitklapmenu's op desktop                                           */
  /* ------------------------------------------------------------------ */
  const items = [...document.querySelectorAll<HTMLElement>('.heeft-submenu')];

  function sluitAlles(behalve?: HTMLElement) {
    for (const item of items) {
      if (item === behalve) continue;
      item.querySelector('[data-uitklap]')?.setAttribute('aria-expanded', 'false');
      item.querySelector('.submenu')?.setAttribute('hidden', '');
    }
  }

  for (const item of items) {
    const knop = item.querySelector<HTMLButtonElement>('[data-uitklap]');
    const paneel = item.querySelector<HTMLElement>('.submenu');
    if (!knop || !paneel) continue;

    const zet = (open: boolean) => {
      knop.setAttribute('aria-expanded', String(open));
      if (open) paneel.removeAttribute('hidden');
      else paneel.setAttribute('hidden', '');
    };

    knop.addEventListener('click', () => {
      const open = knop.getAttribute('aria-expanded') === 'true';
      sluitAlles(item);
      zet(!open);
    });

    // Voor de muis: openen bij hover, zodat het aanvoelt als een gewoon menu.
    // Sluiten gebeurt met een korte vertraging; een schuine beweging langs de
    // rand van de knop mag het paneel niet meteen dichtgooien.
    let sluittimer = 0;
    const stopTimer = () => {
      if (sluittimer) { window.clearTimeout(sluittimer); sluittimer = 0; }
    };

    item.addEventListener('pointerenter', (gebeurtenis) => {
      if ((gebeurtenis as PointerEvent).pointerType !== 'mouse') return;
      stopTimer();
      sluitAlles(item);
      zet(true);
    });
    item.addEventListener('pointerleave', (gebeurtenis) => {
      if ((gebeurtenis as PointerEvent).pointerType !== 'mouse') return;
      stopTimer();
      sluittimer = window.setTimeout(() => zet(false), 180);
    });

    // Sluiten zodra de focus het menu verlaat, anders blijft hij bij tabben open.
    item.addEventListener('focusout', () => {
      window.setTimeout(() => {
        if (!item.contains(document.activeElement)) zet(false);
      }, 0);
    });
  }

  document.addEventListener('click', (gebeurtenis) => {
    const doel = gebeurtenis.target as Node;
    if (!items.some((item) => item.contains(doel))) sluitAlles();
  });

  /* ------------------------------------------------------------------ */
  /* Overlaymenu                                                        */
  /* ------------------------------------------------------------------ */
  const overlay = document.querySelector<HTMLElement>('[data-overlay]');
  const openKnop = document.querySelector<HTMLButtonElement>('[data-overlay-open]');
  const sluitKnop = document.querySelector<HTMLButtonElement>('[data-overlay-close]');

  function zetOverlay(open: boolean) {
    if (!overlay || !openKnop) return;
    if (open) overlay.removeAttribute('hidden');
    else overlay.setAttribute('hidden', '');
    openKnop.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('geen-scroll', open);
    if (open) sluitKnop?.focus();
    else openKnop.focus();
  }

  openKnop?.addEventListener('click', () => zetOverlay(true));
  sluitKnop?.addEventListener('click', () => zetOverlay(false));

  document.addEventListener('keydown', (gebeurtenis) => {
    if (gebeurtenis.key !== 'Escape') return;
    if (overlay && !overlay.hasAttribute('hidden')) zetOverlay(false);
    else sluitAlles();
  });

  // Bij het draaien naar landschap of het verbreden van het venster kan het
  // overlaymenu overbodig worden. Dan hoort hij dicht te gaan.
  const breed = window.matchMedia('(min-width: 1280px)');
  breed.addEventListener('change', (gebeurtenis) => {
    if (gebeurtenis.matches && overlay && !overlay.hasAttribute('hidden')) zetOverlay(false);
  });
</script>
