---
/**
 * Het venster waarin een foto groot opent. Zet het een keer op de pagina en
 * geef elke klikbare foto een knop met data-vergroot (de bron) en data-alt.
 */
---

<dialog class="fotovenster" data-fotovenster aria-label="Foto">
  <img src="" alt="" data-fotovenster-beeld />
  <button type="button" class="fotovenster-sluit" data-fotovenster-sluit aria-label="Sluiten">
    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
      <path d="M3 3l10 10M13 3 3 13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  </button>
</dialog>

<script>
  /**
   * Foto groter bekijken. Een klik op de foto opent hem in z'n geheel, zonder
   * de uitsnede van de pagina. Een klik waar dan ook, Escape of het kruisje
   * sluit hem weer; <dialog> regelt de focus en de Escape-toets zelf.
   */
  const venster = document.querySelector<HTMLDialogElement>('[data-fotovenster]');
  const beeld = venster?.querySelector<HTMLImageElement>('[data-fotovenster-beeld]');

  if (venster && beeld) {
    for (const knop of document.querySelectorAll<HTMLButtonElement>('[data-vergroot]')) {
      knop.addEventListener('click', () => {
        beeld.src = knop.dataset.vergroot ?? '';
        beeld.alt = knop.dataset.alt ?? '';
        venster.showModal();
      });
    }

    venster.addEventListener('click', () => venster.close());
    venster.addEventListener('close', () => {
      beeld.removeAttribute('src');
    });
  }
</script>

<style>
.fotovenster {
  max-width: none;
  max-height: none;
  width: 100vw;
  height: 100dvh;
  margin: 0;
  padding: clamp(1rem, 4vw, 3rem);
  border: 0;
  background: transparent;
  cursor: zoom-out;
}
.fotovenster[open] { display: grid; place-items: center; }
.fotovenster::backdrop { background: rgb(0 0 0 / 0.88); }
.fotovenster img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  border-radius: var(--radius-vlak);
}
.fotovenster-sluit {
  position: fixed;
  top: 1rem;
  right: 1rem;
  display: grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  border: 1px solid rgb(255 255 255 / 0.35);
  border-radius: 999px;
  background: rgb(0 0 0 / 0.5);
  color: var(--color-wit);
  cursor: pointer;
}
.fotovenster-sluit:hover { background: var(--color-wit); color: var(--color-zwart); }
@media (prefers-reduced-motion: no-preference) {
  .fotovenster[open] { animation: fotovenster-in 0.2s ease-out; }
  @keyframes fotovenster-in { from { opacity: 0; transform: scale(0.98); } }
}
</style>
