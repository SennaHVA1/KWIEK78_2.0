---
/**
 * Wie er binnenkort jarig is.
 *
 * Dit was een kalender per maand, maar Sportlink levert alleen de jarigen van
 * de komende paar weken aan. Twaalf maanden waarvan er elf leeg zijn is geen
 * kalender, dus nu staat er een doorlopende lijst vanaf vandaag. De site wordt
 * elke ochtend opnieuw gebouwd, dus de lijst schuift vanzelf mee.
 *
 * Alleen naam en dag. Het geboortejaar wordt bewust niet uit Sportlink
 * overgenomen: dat is een herleidbaar persoonsgegeven en voor een felicitatie
 * heb je het niet nodig.
 */
import Basis from '../../layouts/Basis.astro';
import Paginakop from '../../components/Paginakop.astro';
import Verjaardagen from '../../components/Verjaardagen.astro';
import { getKomendeVerjaardagen } from '../../lib/sportlink';

const DAGEN = 31;
const jarigen = getKomendeVerjaardagen(DAGEN);
---

<Basis
  titel="Verjaardagen"
  omschrijving="Welke leden van v.v. Kwiek '78 binnenkort jarig zijn."
>
  <Paginakop
    foto="/images/club/kaart-sportpark.webp"
    fotoPositie="center 50%"
    kicker="Club"
    titel="Binnenkort jarig"
    intro="Wie er de komende weken jarig is. Alleen naam en dag, geen geboortejaar."
  />

  <section class="vlak-wit sectie">
    <div class="omhulsel">
      <div class="kolom">
        <p class="kolom-kicker">
          {jarigen.length === 1 ? 'Een jarige' : `${jarigen.length} jarigen`}
        </p>

        <div>
          <Verjaardagen
            leden={jarigen}
            leegTekst="De komende weken is er niemand jarig."
          />

          <p class="privacy-noot zacht">
            Leden die in Sportlink hebben aangegeven niet zichtbaar te willen zijn, staan hier niet.
            Dat kun je zelf instellen in de KNVB-app, bij Privacy-instellingen.
          </p>
        </div>
      </div>
    </div>
  </section>
</Basis>

<style>
  .privacy-noot {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--kleur-lijn-licht);
    font-size: var(--text-mini);
    line-height: 1.6;
    max-width: 62ch;
  }
</style>
