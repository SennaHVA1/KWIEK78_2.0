---
/**
 * De voettekst. Hier staan ook de juridische pagina's, die bewust niet in het
 * hoofdmenu zitten.
 */
import { CLUBGEGEVENS, routeLink } from '../lib/club';
import { SNELLE_LINKS, JURIDISCH } from '../lib/menu';
import { huidigJaar } from '../lib/datum';

const socials = [
  { label: 'Facebook', href: CLUBGEGEVENS.facebook },
  { label: 'X', href: CLUBGEGEVENS.x },
  { label: 'YouTube', href: CLUBGEGEVENS.youtube },
];
---

<footer class="voet">
  <div class="baan" aria-hidden="true"></div>

  <div class="omhulsel voet-binnen">
    <div class="voet-raster">
      <div class="voet-blok voet-blok--merk">
        <span class="voet-wapen">
          <img src="/images/logos/kwiek-78.png" alt="" width="140" height="82" />
        </span>
        <address class="voet-adres">
          <strong>{CLUBGEGEVENS.naam}</strong><br />
          {CLUBGEGEVENS.sportpark}<br />
          {CLUBGEGEVENS.straat}<br />
          {CLUBGEGEVENS.postcode} {CLUBGEGEVENS.plaats}
        </address>
        <p class="voet-contact data">
          <a class="link-onder" href={`tel:${CLUBGEGEVENS.telefoon.replace(/\s/g, '')}`}>{CLUBGEGEVENS.telefoon}</a><br />
          <a class="link-onder" href={`mailto:${CLUBGEGEVENS.email}`}>{CLUBGEGEVENS.email}</a>
        </p>
        <a class="knop knop--rand" href={routeLink()} target="_blank" rel="noopener noreferrer">Route naar het sportpark</a>
      </div>

      <nav class="voet-blok" aria-label="Snelle links">
        <h2 class="voet-kop">Snel naar</h2>
        <ul>
          {SNELLE_LINKS.map((link) => (
            <li>
              <a
                class="link-onder"
                href={link.href}
                target={link.extern ? '_blank' : undefined}
                rel={link.extern ? 'noopener noreferrer' : undefined}
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="voet-blok">
        <h2 class="voet-kop">Volg de club</h2>
        <ul>
          {socials.map((social) => (
            <li>
              <a class="link-onder" href={social.href} target="_blank" rel="noopener noreferrer">{social.label}</a>
            </li>
          ))}
        </ul>

        <h2 class="voet-kop voet-kop--tweede">Juridisch</h2>
        <ul>
          {JURIDISCH.map((link) => (
            <li><a class="link-onder" href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="voet-onder">
      <p class="data">
        &copy; {huidigJaar()} {CLUBGEGEVENS.naam}, opgericht {CLUBGEGEVENS.opgericht}.
        KNVB-clubcode {CLUBGEGEVENS.knvbClubcode}.
      </p>
      <p class="data voet-demo">
        Demo-omgeving. Wedstrijd- en ledendata zijn voorbeeldgegevens.
      </p>
    </div>
  </div>
</footer>

<style>
  .voet {
    background: var(--color-zwart);
    color: var(--color-wit);
    margin-top: auto;
  }
  .voet-binnen { padding-block: clamp(2.5rem, 5vw, 4rem) 2rem; }

  .voet-raster {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .voet-raster { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .voet-raster { grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr)); gap: 3rem; }
  }

  .voet-blok { display: grid; gap: 1rem; align-content: start; }
  /* Het echte logo op een lichte tegel, net als in de koptekst. */
  .voet-wapen {
    display: block;
    width: fit-content;
    background: var(--color-wit);
    border-radius: var(--radius-klein);
    padding: 0.5rem 0.7rem;
    line-height: 0;
  }
  .voet-wapen img { width: 140px; }
  .voet-blok ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .voet-blok a { color: var(--color-wit); text-decoration: none; font-size: 1rem; }
  .voet-blok .knop { justify-self: start; }

  .voet-kop {
    font-family: var(--font-smal);
    font-size: var(--text-kop-s);
    font-weight: 700;
    color: var(--color-wit);
  }
  .voet-kop--tweede { margin-top: 0.75rem; }

  .voet-adres { font-style: normal; font-size: 1rem; line-height: 1.7; color: var(--color-grijs); }
  .voet-adres strong { font-family: var(--font-smal); font-size: 1.25rem; font-weight: 700; color: var(--color-wit); }
  .voet-contact { font-size: 1rem; line-height: 1.8; }
  .voet-contact a { color: var(--color-blauw); text-decoration: none; }

  .voet-onder {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--kleur-lijn-donker);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-size: var(--text-klein);
    color: var(--color-grijs);
  }
  .voet-demo { color: var(--color-blauw); }
</style>
