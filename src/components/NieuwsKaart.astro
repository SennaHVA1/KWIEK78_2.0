---
/**
 * Een nieuwsbericht in een lijst.
 *
 * Geen kaart met afgeronde hoeken en schaduw: een blok met een haarlijn
 * erboven, de datum in de kantlijn en de foto strak in het raster.
 */
import Foto from './Foto.astro';
import { datumZonderDag, machineDatum } from '../lib/datum';
import type { Artikel } from '../lib/types';

interface Props {
  artikel: Artikel;
  /** Grote variant, voor het eerste bericht in een overzicht. */
  groot?: boolean;
  /**
   * Kopniveau van de titel. Staat de lijst los op een pagina, dan is 2 goed;
   * hangt hij onder een sectiekop, geef dan 3 mee.
   */
  kopNiveau?: 2 | 3;
  /**
   * Onder 640px inklappen tot een regel met een klein vierkant beeld ernaast,
   * zonder samenvatting. Voor de homepage: daar is nieuws bijvangst en niet
   * waarvoor iemand op zaterdagochtend de site opent.
   */
  compactOpMobiel?: boolean;
}

const { artikel, groot = false, kopNiveau = 3, compactOpMobiel = false } = Astro.props;
const Kop = `h${kopNiveau}` as 'h2' | 'h3';
---

<article class:list={['nieuwskaart', groot && 'nieuwskaart--groot', compactOpMobiel && 'nieuwskaart--compact']}>
  <a class="nieuwskaart-link" href={`/nieuws/${artikel.slug}`}>
    <div class="nieuwskaart-beeld">
      <Foto
        src={artikel.afbeelding}
        alt={`Foto bij het bericht: ${artikel.titel}`}
        ratio={groot ? '16 / 9' : '4 / 3'}
        plaatshouder="foto volgt"
      />
    </div>

    <div class="nieuwskaart-tekst">
      <p class="nieuwskaart-meta data">
        <time datetime={machineDatum(artikel.datum)}>{datumZonderDag(artikel.datum)}</time>
        {artikel.bron === 'facebook' && <span class="nieuwskaart-bron">via Facebook</span>}
      </p>
      <Kop class:list={[groot ? 'kop-m' : 'kop-s']}>{artikel.titel}</Kop>
      <p class="nieuwskaart-samenvatting">{artikel.samenvatting}</p>
      <span class="nieuwskaart-lees data">Lees verder</span>
    </div>
  </a>
</article>

<style>
  .nieuwskaart-link {
    display: grid;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
    height: 100%;
    align-content: start;
  }

  .nieuwskaart-beeld { overflow: hidden; border-radius: var(--radius-vlak); }
  .nieuwskaart-beeld :global(img) {
    transition: transform 0.5s var(--ease-klap);
  }
  .nieuwskaart-link:hover .nieuwskaart-beeld :global(img) { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    .nieuwskaart-beeld :global(img) { transition: none; }
    .nieuwskaart-link:hover .nieuwskaart-beeld :global(img) { transform: none; }
  }

  .nieuwskaart-tekst { display: grid; gap: 0.5rem; align-content: start; }

  .nieuwskaart-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-smal);
    font-size: var(--text-mini);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-grijs);
  }
  :global(.vlak-wit) .nieuwskaart-meta { color: var(--color-grijsdonker); }
  .nieuwskaart-bron { color: var(--color-blauw); }
  :global(.vlak-wit) .nieuwskaart-bron { color: var(--color-blauwdiep); }

  .nieuwskaart-samenvatting {
    font-size: var(--text-klein);
    line-height: 1.6;
    color: var(--color-grijs);
    max-width: 52ch;
  }
  :global(.vlak-wit) .nieuwskaart-samenvatting { color: var(--color-grijsdonker); }

  .nieuwskaart-lees {
    font-size: var(--text-klein);
    font-weight: 600;
    color: var(--color-blauw);
    margin-top: 0.15rem;
  }
  :global(.vlak-wit) .nieuwskaart-lees { color: var(--color-blauwdiep); }
  .nieuwskaart-link:hover .nieuwskaart-lees { text-decoration: underline; text-underline-offset: 0.25em; }

  @media (min-width: 720px) {
    .nieuwskaart--groot .nieuwskaart-link {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }
  }

  /* Compacte variant, alleen op een telefoon. Beeld naar een klein vierkant
     naast de tekst, samenvatting en "Lees verder" eruit. Vier berichten passen
     dan in de hoogte van een enkele kaart van hiervoor. */
  @media (max-width: 639px) {
    .nieuwskaart--compact .nieuwskaart-link {
      grid-template-columns: 84px minmax(0, 1fr);
      gap: 0.9rem;
      align-items: center;
    }
    .nieuwskaart--compact .nieuwskaart-beeld { border-radius: var(--radius-klein); }
    .nieuwskaart--compact .nieuwskaart-beeld :global(img),
    .nieuwskaart--compact .nieuwskaart-beeld :global(.foto-plek) {
      aspect-ratio: 1 / 1 !important;
    }
    .nieuwskaart--compact .nieuwskaart-tekst { gap: 0.2rem; }
    .nieuwskaart--compact .nieuwskaart-tekst :is(h2, h3) {
      font-size: 1.0625rem;
      line-height: 1.25;
    }
    .nieuwskaart--compact .nieuwskaart-samenvatting,
    .nieuwskaart--compact .nieuwskaart-lees { display: none; }
  }
</style>
