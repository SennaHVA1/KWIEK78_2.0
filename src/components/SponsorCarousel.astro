---
/**
 * De sponsoren, doorlopend.
 *
 * Zelf geschreven, geen carouselbibliotheek: een spoor dat schuift met een
 * CSS-animatie en een verborgen kopie, zodat de lus naadloos is.
 *
 * Elk logo staat op een eigen kaartje van dezelfde maat. De logo's komen van
 * overal - brede woordmerken, vierkante stempels, jpg's met een witte rand -
 * en los naast elkaar oogde dat als een rommelige rij. Op een vaste kaart
 * met lucht eromheen worden ze een reeks. Logo's die voor een zwarte
 * ondergrond gemaakt zijn (vlak: 'donker' in sponsoren.json) krijgen een
 * zwart kaartje.
 *
 * Pauzeert bij hover op een muisapparaat en bij toetsenbordfocus, maar nooit
 * op een aanraakscherm: daar blijft hover plakken. Bij prefers-reduced-motion
 * staat de animatie uit en wordt het een gewone, horizontaal scrollbare rij.
 *
 * OVER DE PRESTATIES OP EEN TELEFOON
 * Het spoor is een enkele geschakelde laag; hoe breder, hoe meer geheugen.
 * Daarom precies twee reeksen: een reeks van vijftien kaartjes is ruim
 * drieduizend pixels, breder dan elk scherm, dus twee is genoeg voor een
 * naadloze lus. Geen mask-image (dat kost een tweede laag), maar twee
 * verlopen in de kleur van het vlak. Alle logo's laden eager en elk kaartje
 * heeft een vaste maat, zodat de naad klopt voor en na het laden. Uit beeld
 * staat de animatie stil (zie het script onderaan).
 */
import { fotoBestaat } from '../lib/fotos';
import type { Sponsor } from '../lib/types';

interface Props {
  sponsoren: Sponsor[];
}

const { sponsoren } = Astro.props;

/* De tweede reeks is decor: aria-hidden en niet met de tab-toets te bereiken. */
const spoor = [
  { sponsoren, kopie: false },
  { sponsoren, kopie: true },
];
---

<div class="carousel" data-carousel>
  <div class="carousel-spoor">
    {spoor.map((reeks) => (
      <ul class="carousel-reeks" aria-hidden={reeks.kopie ? 'true' : undefined}>
        {reeks.sponsoren.map((sponsor) => (
          <li>
            <a
              class="carousel-kaart"
              href={sponsor.url}
              target={sponsor.url ? '_blank' : undefined}
              rel={sponsor.url ? 'noopener noreferrer' : undefined}
              tabindex={reeks.kopie || !sponsor.url ? -1 : undefined}
              data-vlak={sponsor.vlak}
              title={sponsor.naam}
            >
              {fotoBestaat(sponsor.logo) ? (
                <img src={sponsor.logo} alt={sponsor.naam} loading="eager" decoding="async" fetchpriority="low" />
              ) : (
                <span class="carousel-woordmerk">{sponsor.naam}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .carousel {
    /* Ruimte tussen twee kaartjes, en dus ook op de naad. */
    --gat: clamp(0.75rem, 1.5vw, 1.25rem);
    /* De kleur van het vlak waar de carousel in staat. */
    --carousel-vlak: var(--color-wit);
    position: relative;
    overflow: hidden;
    padding-block: 0.5rem;
  }

  /* Vervagende randen, boven op het spoor in plaats van als masker. */
  .carousel::before,
  .carousel::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(2rem, 8vw, 7rem);
    pointer-events: none;
    z-index: 1;
  }
  .carousel::before { left: 0;  background: linear-gradient(90deg, var(--carousel-vlak), transparent); }
  .carousel::after  { right: 0; background: linear-gradient(270deg, var(--carousel-vlak), transparent); }

  .carousel-spoor {
    display: flex;
    width: max-content;
    animation: schuiven 80s linear infinite;
    backface-visibility: hidden;
  }
  @media (hover: hover) and (pointer: fine) {
    .carousel:hover .carousel-spoor { animation-play-state: paused; }
  }
  .carousel:focus-within .carousel-spoor { animation-play-state: paused; }
  .carousel[data-uit-beeld] .carousel-spoor { animation-play-state: paused; }

  /* Twee even brede reeksen: na een halve spoorbreedte staat de kopie precies
     waar het origineel begon en is de sprong onzichtbaar. Elke reeks draagt
     zijn eindgat als marge, zodat de afstand op de naad gelijk is aan die
     tussen twee kaartjes. */
  @keyframes schuiven {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  .carousel-reeks {
    display: flex;
    align-items: center;
    gap: var(--gat);
    margin: 0 var(--gat) 0 0;
    list-style: none;
    padding: 0;
  }

  /* Zuiver wit, niet het gebroken wit van de pagina: een flink deel van de
     logo's is een jpg met een witte achtergrond, en die moet wegvallen. */
  .carousel-kaart {
    --kaart-b: clamp(9.5rem, 14vw, 12rem);
    display: grid;
    /* Een vaste cel, zodat het logo zich naar de kaart voegt en niet andersom. */
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    box-sizing: border-box;
    width: var(--kaart-b);
    height: calc(var(--kaart-b) * 9 / 16);
    padding: clamp(0.9rem, 1.4vw, 1.25rem) clamp(1rem, 1.6vw, 1.5rem);
    border: 1px solid var(--kleur-lijn-licht);
    border-radius: var(--radius-vlak);
    background: #fff;
    transition:
      transform 0.25s var(--ease-klap),
      border-color 0.25s var(--ease-klap),
      box-shadow 0.25s var(--ease-klap);
  }
  .carousel-kaart[data-vlak="donker"] {
    background: var(--color-zwart);
    border-color: var(--color-zwart);
  }
  .carousel-kaart:hover,
  .carousel-kaart:focus-visible {
    transform: translateY(-3px);
    border-color: var(--color-zwart);
    box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.35);
  }

  .carousel-kaart img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .carousel-woordmerk {
    font-family: var(--font-smal);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    text-align: center;
    color: var(--color-zwart);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel {
      overflow-x: auto;
      scroll-snap-type: x proximity;
    }
    .carousel::before, .carousel::after { display: none; }
    .carousel-spoor { animation: none; }
    .carousel-reeks[aria-hidden="true"] { display: none; }
    .carousel-reeks { margin-right: 0; padding-inline: var(--spacing-kantlijn); }
    .carousel-reeks li { scroll-snap-align: start; }
    .carousel-kaart { transition: none; }
    .carousel-kaart:hover { transform: none; }
  }
</style>

<script>
  /**
   * Zet het spoor stil zolang het blok niet in beeld staat. De carousel staat
   * onderaan de homepage; zonder dit draait de animatie de hele tijd dat iemand
   * bovenaan het nieuws leest, en dat kost op een telefoon merkbaar soepelheid.
   */
  const carousels = document.querySelectorAll<HTMLElement>('[data-carousel]');

  if (carousels.length > 0 && 'IntersectionObserver' in window) {
    const waarnemer = new IntersectionObserver(
      (items) => {
        for (const item of items) {
          const el = item.target as HTMLElement;
          if (item.isIntersecting) el.removeAttribute('data-uit-beeld');
          else el.setAttribute('data-uit-beeld', '');
        }
      },
      { rootMargin: '200px 0px' },
    );

    carousels.forEach((el) => {
      el.setAttribute('data-uit-beeld', '');
      waarnemer.observe(el);
    });
  }
</script>
