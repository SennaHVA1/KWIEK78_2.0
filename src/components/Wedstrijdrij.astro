---
/**
 * Een wedstrijd als rij.
 *
 * Geen kaart, geen schaduw: een rij met een haarlijn erboven, zoals een regel
 * op een wedstrijdformulier. Dit is het meest herhaalde element van de site,
 * dus het moet op 360 pixels breed net zo goed werken als op 1440.
 *
 * De afgelast-staat is bewust luidruchtig: doorgehaalde clubnamen, een
 * diagonale arcering over de rij en een blauw label. Dat is het moment waarop
 * een clubsite zijn waarde bewijst.
 */
import Clubwapen from './Clubwapen.astro';
import { tijd, korteDatum } from '../lib/datum';
import { CLUB } from '../lib/sportlink';
import type { Wedstrijd } from '../lib/types';

interface Props {
  wedstrijd: Wedstrijd;
  /** Datum tonen in de rij zelf, voor lijsten die niet per dag gegroepeerd zijn. */
  toonDatum?: boolean;
  /** Accommodatie tonen. Uit op de teampagina, waar dat vaak hetzelfde is. */
  toonLocatie?: boolean;
}

const { wedstrijd, toonDatum = false, toonLocatie = true } = Astro.props;

const heeftUitslag = wedstrijd.uitslag !== undefined;
const isThuis = wedstrijd.thuisteam.startsWith(CLUB);
const soortLabel: Record<Wedstrijd['competitie'], string> = {
  competitie: 'Competitie',
  beker: 'Beker',
  oefen: 'Oefen',
  zaal: 'Zaal',
};

/* Voor het filter op de programmapagina. Dit attribuut staat altijd in de
   HTML: dat kost niets en scheelt een tweede variant van dit component. */
const eigenTeam = isThuis ? wedstrijd.thuisteam : wedstrijd.uitteam;

/* Toegankelijke omschrijving van de hele rij, zodat een schermlezer niet de
   losse fragmenten hoeft samen te rapen. */
const omschrijving = [
  wedstrijd.afgelast ? 'Afgelast: ' : '',
  `${wedstrijd.thuisteam} tegen ${wedstrijd.uitteam}`,
  heeftUitslag ? `, uitslag ${wedstrijd.uitslag!.thuis} - ${wedstrijd.uitslag!.uit}` : '',
  toonDatum ? `, ${korteDatum(wedstrijd.datum)}` : '',
  ` ${tijd(wedstrijd.datum)}`,
].join('');
---

<a
  class:list={['rij', 'wedstrijdrij', wedstrijd.afgelast && 'is-afgelast']}
  href={`/wedstrijd/${wedstrijd.wedstrijdcode}`}
  aria-label={omschrijving}
  data-wedstrijdrij
  data-team={eigenTeam}
  data-locatie={isThuis ? 'thuis' : 'uit'}
  data-soort={wedstrijd.competitie}
>
  <div class="wedstrijdrij-tijd data">
    {toonDatum && <span class="wedstrijdrij-datum">{korteDatum(wedstrijd.datum)}</span>}
    <span>{tijd(wedstrijd.datum)}</span>
  </div>

  <div class="wedstrijdrij-teams" aria-hidden="true">
    <span class:list={['wedstrijdrij-team', wedstrijd.afgelast && 'doorgehaald']}>
      <Clubwapen src={wedstrijd.thuisLogo} club={wedstrijd.thuisteam} formaat={26} />
      <span class="wedstrijdrij-naam">{wedstrijd.thuisteam}</span>
    </span>
    <span class:list={['wedstrijdrij-scheiding', 'data', heeftUitslag && 'is-uitslag']}>
      {heeftUitslag ? `${wedstrijd.uitslag!.thuis} - ${wedstrijd.uitslag!.uit}` : '-'}
    </span>
    <span class:list={['wedstrijdrij-team', 'wedstrijdrij-team--uit', wedstrijd.afgelast && 'doorgehaald']}>
      <Clubwapen src={wedstrijd.uitLogo} club={wedstrijd.uitteam} formaat={26} />
      <span class="wedstrijdrij-naam">{wedstrijd.uitteam}</span>
    </span>
  </div>

  <div class="wedstrijdrij-staart">
    {wedstrijd.afgelast
      ? <span class="merk merk--afgelast">Afgelast</span>
      : <span class="merk merk--rand">{soortLabel[wedstrijd.competitie]}</span>}
    <span class:list={['merk', isThuis ? 'merk--thuis' : 'merk--rand']}>{isThuis ? 'Thuis' : 'Uit'}</span>
  </div>

  {toonLocatie && (
    <div class="wedstrijdrij-locatie zacht">
      {wedstrijd.accommodatie}{wedstrijd.veld ? `, ${wedstrijd.veld}` : ''}
    </div>
  )}
</a>

<style>
  .wedstrijdrij {
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "tijd   teams"
      "staart staart"
      "locatie locatie";
    column-gap: 0.9rem;
    row-gap: 0.45rem;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.16s var(--ease-klap);
  }
  .wedstrijdrij:hover { background: color-mix(in srgb, currentColor 5%, transparent); }
  @media (prefers-reduced-motion: reduce) { .wedstrijdrij { transition: none; } }

  .wedstrijdrij-tijd {
    grid-area: tijd;
    display: grid;
    font-size: var(--text-klein);
    font-weight: 700;
    line-height: 1.3;
    min-width: 3.2rem;
    align-self: center;
  }
  .wedstrijdrij-datum { color: var(--color-grijs); font-weight: 400; }
  :global(.vlak-wit) .wedstrijdrij-datum { color: var(--color-grijsdonker); }

  .wedstrijdrij-teams {
    grid-area: teams;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .wedstrijdrij-team {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    font-weight: 600;
    font-size: var(--text-klein);
  }
  .wedstrijdrij-team--uit { flex-direction: row-reverse; text-align: right; }
  .wedstrijdrij-naam {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .wedstrijdrij-scheiding {
    font-size: var(--text-klein);
    font-weight: 700;
    color: var(--color-grijs);
    padding-inline: 0.15rem;
    white-space: nowrap;
  }
  :global(.vlak-wit) .wedstrijdrij-scheiding { color: var(--color-grijsdonker); }

  .wedstrijdrij-staart {
    grid-area: staart;
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .wedstrijdrij-locatie {
    grid-area: locatie;
    font-size: var(--text-klein);
  }

  @media (min-width: 768px) {
    .wedstrijdrij {
      grid-template-columns: 5.5rem minmax(0, 1fr) auto;
      grid-template-areas:
        "tijd teams staart"
        "tijd locatie staart";
      column-gap: 1.25rem;
      row-gap: 0.2rem;
    }
    .wedstrijdrij-tijd { font-size: var(--text-basis); align-self: center; }
    .wedstrijdrij-team { font-size: var(--text-basis); }
    .wedstrijdrij-scheiding { font-size: var(--text-basis); padding-inline: 0.5rem; }
    .wedstrijdrij-staart { align-self: center; flex-wrap: nowrap; }
  }

  /* Bij een gespeelde wedstrijd is de uitslag het belangrijkste getal in de
     rij. Die krijgt daarom de accentkleur; dit is een van de weinige plekken
     waar het blauw wordt ingezet. */
  .wedstrijdrij-scheiding.is-uitslag {
    color: var(--color-blauw);
    background: color-mix(in srgb, var(--color-blauw) 14%, transparent);
    padding: 0.1rem 0.45rem;
  }
  /* 8 procent en niet meer: bij een sterkere vulling zakt blauwdiep op dit
     vlak onder de 4.5:1 die WCAG AA voor tekst van deze grootte vraagt. */
  :global(.vlak-wit) .wedstrijdrij-scheiding.is-uitslag {
    color: var(--color-blauwdiep);
    background: color-mix(in srgb, var(--color-blauwdiep) 8%, transparent);
  }
</style>
