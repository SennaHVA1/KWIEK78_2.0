---
/**
 * De homepage.
 *
 * Volgorde is bewust: hero, eerstvolgende wedstrijd, nieuws, agenda,
 * verjaardagen, sponsoren. De hoofdgebruiker is een ouder die zaterdagochtend
 * om kwart over acht op de telefoon kijkt of de wedstrijd doorgaat. Daarom is
 * de hero op mobiel laag gehouden en staan er drie snelknoppen in beeld die
 * rechtstreeks naar het programma, de uitslagen en de diensten gaan.
 */
import Basis from '../layouts/Basis.astro';
import Foto from '../components/Foto.astro';
import EerstvolgendeWedstrijd from '../components/EerstvolgendeWedstrijd.astro';
import NieuwsKaart from '../components/NieuwsKaart.astro';
import AgendaLijst from '../components/AgendaLijst.astro';
import Verjaardagen from '../components/Verjaardagen.astro';
import SponsorCarousel from '../components/SponsorCarousel.astro';

import { getEerstvolgendeWedstrijden, getVerjaardagenDezeWeek } from '../lib/sportlink';
import { getLaatsteNieuws } from '../lib/nieuws';
import { getKomendeAgenda, getCarouselSponsoren } from '../lib/club';

const komendeWedstrijden = getEerstvolgendeWedstrijden('kwiek-78-1', 4);
const nieuws = getLaatsteNieuws(4);
const agenda = getKomendeAgenda(4);
const jarigen = getVerjaardagenDezeWeek();
const sponsoren = getCarouselSponsoren();

/* De drie dingen waarvoor mensen hier komen, meteen in beeld. */
const snelknoppen = [
  { label: 'Programma', uitleg: 'Wie speelt wanneer', href: '/wedstrijden/programma' },
  { label: 'Uitslagen', uitleg: 'Hoe is het afgelopen', href: '/wedstrijden/uitslagen' },
  { label: 'Diensten', uitleg: 'Wanneer ben ik aan de beurt', href: '/vrijwillige-diensten' },
];

/* Het mozaiek onder de agenda. `vak` bepaalt de plek in het raster. */
const sfeer = [
  { vak: 'groot', src: '/images/club/kantine-vol.webp', alt: 'Een volle kantine van Kwiek \'78 met supporters aan tafel en aan de bar' },
  { vak: 'breed', src: '/images/club/kantine-darts.webp', alt: 'Twee dartborden met het logo van Kwiek \'78 in de kantine' },
  { vak: 'klein', src: '/images/club/aan-de-bal.webp', alt: 'Een speler van Kwiek \'78 in het zwarte tenue aan de bal op het kunstgras', positie: '22% 50%' },
  { vak: 'klein', src: '/images/teams/kwiek-78-vr1-actie-1.webp', alt: 'Een speelster van VR1 aan de bal tussen twee tegenstanders' },
];
---

<Basis
  titel="Home"
  omschrijving="Voetbalvereniging Kwiek '78 uit Avenhorn. Programma, uitslagen, standen, teams en clubnieuws op een plek."
>
  <!-- ================================================================== -->
  <!-- Hero                                                               -->
  <!-- ================================================================== -->
  {/* De foto heeft de hoofdrol. Erover staan alleen de clubnaam, een knop om
      lid te worden en onderin een balk met de drie taken waarvoor mensen de
      site openen. Geen introtekst: wie hier komt weet welke club het is. */}
  <section class="hero vlak-zwart">
    <div class="hero-beeld" aria-hidden="true">
      <Foto
        src="/images/club/hero-heren-1.webp"
        alt=""
        ratio="3 / 2"
        prioriteit
        plaatshouder="club/hero-heren-1.webp"
      />
    </div>

    <div class="omhulsel hero-binnen">
      <div class="hero-naam">
        <p class="hero-boven">Avenhorn <span aria-hidden="true">&middot;</span> sinds 1978</p>
        <h1 class="hero-titel">Kwiek '78</h1>
      </div>

      <a class="hero-lid" href="/club/lid-worden">
        <span class="hero-lid-sticker">Gratis proeftraining</span>
        <span class="hero-lid-label">Word lid</span>
        <span class="hero-lid-pijl" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </span>
      </a>
    </div>

    <nav class="snel" aria-label="Snel naar">
      <ul class="omhulsel snel-lijst">
        {snelknoppen.map((knop) => (
          <li>
            <a class="snelknop" href={knop.href}>
              <span class="snelknop-label">{knop.label}</span>
              <span class="snelknop-uitleg">{knop.uitleg}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <!-- ================================================================== -->
  <!-- Eerstvolgende wedstrijd                                             -->
  <!-- ================================================================== -->
  <EerstvolgendeWedstrijd wedstrijden={komendeWedstrijden} />

  <div class="baan" aria-hidden="true"></div>

  <!-- ================================================================== -->
  <!-- Laatste nieuws                                                      -->
  <!-- ================================================================== -->
  <section class="vlak-wit sectie" aria-labelledby="nieuws-kop">
    <div class="omhulsel">
      <div class="sectiekop">
        <div>
          <p class="kolom-kicker">Uit de club</p>
          <h2 class="kop-sectie" id="nieuws-kop">Laatste nieuws</h2>
        </div>
        <a class="knop knop--rand" href="/nieuws">Alle berichten</a>
      </div>

      <div class="nieuwsraster">
        {nieuws.map((artikel, i) => (
          <div class="verschijn" style={`transition-delay:${i * 60}ms`}>
            <NieuwsKaart artikel={artikel} compactOpMobiel />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Agenda en verjaardagen                                              -->
  <!-- ================================================================== -->
  <section class="vlak-papier sectie" aria-labelledby="agenda-kop">
    <div class="omhulsel tweeluik">
      <div>
        <div class="sectiekop">
          <div>
            <p class="kolom-kicker">Wat er nog komt</p>
            <h2 class="kop-sectie" id="agenda-kop">Agenda</h2>
          </div>
          <a class="knop knop--rand" href="/club/agenda">Hele agenda</a>
        </div>
        <AgendaLijst items={agenda} toonOmschrijving={false} />
      </div>

      <div>
        <div class="sectiekop">
          <div>
            <p class="kolom-kicker">Even feliciteren</p>
            <h2 class="kop-sectie" id="jarig-kop">Jarig deze week</h2>
          </div>
          <a class="knop knop--rand" href="/club/verjaardagen">Kalender</a>
        </div>
        <Verjaardagen leden={jarigen} />
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Op Het Veer                                                         -->
  <!-- ================================================================== -->
  {/* Sfeerbeeld van de club: een volle kantine, een duel, het dartbord en
      VR1. Geen tekst erbij behalve de kop en de knop; de foto's vertellen
      genoeg. */}
  <div class="baan" aria-hidden="true"></div>

  <section class="vlak-zwart sectie" aria-labelledby="veer-kop">
    <div class="omhulsel">
      <div class="sectiekop">
        <div>
          <p class="kolom-kicker">Sportpark Het Veer</p>
          <h2 class="kop-sectie" id="veer-kop">Dit is Kwiek</h2>
        </div>
        <a class="knop knop--primair" href="/club/lid-worden">Word lid</a>
      </div>

      <ul class="mozaiek">
        {sfeer.map((foto) => (
          <li class={`mozaiek-${foto.vak}`}>
            <Foto src={foto.src} alt={foto.alt} ratio="3 / 2" positie={foto.positie} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="baan" aria-hidden="true"></div>

  <!-- ================================================================== -->
  <!-- Hoofdsponsoren                                                      -->
  <!-- ================================================================== -->
  <section class="vlak-wit sponsors" aria-labelledby="sponsor-kop">
    {/* Dezelfde kop als de drie secties hierboven: kicker, titel in de
        displayletter, knop rechts. Dat was hier niet zo - een kleine kop in
        Barlow zonder kicker, met wel dezelfde knop ernaast - en juist die
        halve gelijkenis maakte het blok raar. De regel loopt nu door van de
        kicker in de titel: "Mede mogelijk gemaakt door / Onze sponsoren". */}
    <div class="omhulsel sponsors-kop">
      <div>
        <p class="kolom-kicker">Mede mogelijk gemaakt door</p>
        <h2 class="kop-sectie" id="sponsor-kop">Onze sponsoren</h2>
      </div>
      <a class="knop knop--rand" href="/sponsoring">Sponsor worden</a>
    </div>
    <SponsorCarousel sponsoren={sponsoren} />
  </section>
</Basis>

<style>
  /* ------------------------------------------------------------------ */
  /* Hero                                                               */
  /* ------------------------------------------------------------------ */
  /* Op een telefoon lager dan het scherm, zodat de aftelklok eronder in
     beeld piept en duidelijk is dat er meer komt. Op een breed scherm bijna
     schermvullend. */
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    isolation: isolate;
    min-height: 72svh;
  }
  @media (min-width: 1024px) {
    .hero { min-height: min(calc(100svh - 5rem), 56rem); }
  }

  .hero-beeld { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .hero-beeld :global(img),
  .hero-beeld :global(.foto-plek) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
    border-radius: 0 !important;
    object-fit: cover;
    /* Liggende teamfoto van Heren 1: het elftal staat in een rij tussen
       ongeveer 30% (koppen) en 68% (schoenen) van de hoogte. Iets boven het
       midden houdt de koppen in beeld; op een smal scherm valt de uitsnede op
       het midden van de rij, rond de keeper. */
    object-position: center 40%;
  }
  /* Alleen onderin verduisterd, waar naam, knop en balk staan. De rest van de
     foto blijft open en in kleur. */
  .hero-beeld::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-zwart) 35%, transparent) 0%,
      transparent 18%,
      transparent 45%,
      color-mix(in srgb, var(--color-zwart) 55%, transparent) 68%,
      color-mix(in srgb, var(--color-zwart) 92%, transparent) 100%
    );
  }
  /* Op een telefoon staan naam en uitleg onder elkaar en lopen ze tot halverwege
     de foto door, over de spelers heen. Daar begint de verduistering eerder. */
  @media (max-width: 759px) {
    .hero-beeld::after {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-zwart) 30%, transparent) 0%,
        transparent 16%,
        transparent 30%,
        color-mix(in srgb, var(--color-zwart) 70%, transparent) 52%,
        color-mix(in srgb, var(--color-zwart) 94%, transparent) 100%
      );
    }
  }

  /* Naam links, knop rechts, op dezelfde onderlijn. Op een telefoon onder
     elkaar. */
  .hero-binnen {
    display: grid;
    align-content: end;
    justify-items: start;
    gap: 1.25rem;
    padding-top: 6rem;
    padding-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  @media (min-width: 760px) {
    .hero-binnen {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 2rem;
    }
  }

  .hero-naam { text-shadow: 0 2px 24px color-mix(in srgb, var(--color-zwart) 60%, transparent); }
  .hero-boven {
    font-family: var(--font-smal);
    font-size: clamp(0.8125rem, 0.7rem + 0.4vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-wit);
    margin-bottom: 0.6rem;
  }
  .hero-boven span { color: var(--color-blauw); }
  .hero-titel {
    font-size: clamp(4rem, 1rem + 13vw, 11rem);
    line-height: 0.82;
    text-transform: uppercase;
  }

  /* Lid worden. Een groot blauw blok in de displayletter, het enige blauwe
     vlak in de hero; zwarte tekst haalt op dit blauw 5,3:1. Bovenop een wit
     label dat er schuin op geplakt is, als een sticker: de proeftraining is
     het argument, de knop de actie. */
  .hero-lid {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.9rem;
    padding: 0.85rem 0.85rem 0.85rem 1.6rem;
    border-radius: var(--radius-vlak);
    background: var(--color-blauw);
    color: var(--color-zwart);
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 14px 34px -10px color-mix(in srgb, var(--color-zwart) 80%, transparent);
    transition: background-color 0.18s var(--ease-klap), transform 0.18s var(--ease-klap);
  }
  .hero-lid:hover { background: var(--color-wit); transform: translateY(-2px); }
  .hero-lid:active { transform: translateY(0); }

  .hero-lid-label {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.6rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .hero-lid-pijl {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(2.9rem, 2.4rem + 1.4vw, 3.5rem);
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--color-zwart);
    color: var(--color-wit);
    transition: transform 0.18s var(--ease-klap);
  }
  .hero-lid-pijl svg { width: 45%; height: 45%; }
  .hero-lid:hover .hero-lid-pijl { transform: translateX(4px); }

  .hero-lid-sticker {
    position: absolute;
    top: 0;
    left: 1.1rem;
    translate: 0 -62%;
    rotate: -4deg;
    padding: 0.35rem 0.6rem 0.3rem;
    border-radius: 4px;
    background: var(--color-wit);
    color: var(--color-zwart);
    font-family: var(--font-smal);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    box-shadow: 0 4px 12px -4px color-mix(in srgb, var(--color-zwart) 70%, transparent);
  }
  /* Bij hover wordt de knop zelf wit; de sticker wisselt dan naar zwart. */
  .hero-lid:hover .hero-lid-sticker { background: var(--color-zwart); color: var(--color-wit); }

  @media (min-width: 760px) {
    /* Op de onderkant van de letters, niet van het regelvak. */
    .hero-lid { margin-bottom: 0.35rem; }
  }

  /* ------------------------------------------------------------------ */
  /* Snelknoppen                                                        */
  /* ------------------------------------------------------------------ */
  /* Een balk onderin de hero, gescheiden door een haarlijn. Drie gelijke
     vakken; op een telefoon alleen de labels, vanaf 620px ook de uitleg.
     Let op: .snel-lijst is zelf ook .omhulsel. Scoped stijlen van Astro
     winnen van @layer components, dus hier geen margin of padding-inline
     zetten, anders sneuvelt de centrering. */
  .snel {
    border-top: 1px solid var(--kleur-lijn-donker);
    background: color-mix(in srgb, var(--color-zwart) 55%, transparent);
    backdrop-filter: blur(8px);
  }
  .snel-lijst {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
  }
  .snel-lijst li + li { border-left: 1px solid var(--kleur-lijn-donker); }

  .snelknop {
    display: grid;
    gap: 0.15rem;
    align-content: center;
    /* Ruim boven de 44px die je met een duim moet kunnen raken. */
    min-height: 3.5rem;
    padding: 0.6rem 0.5rem;
    text-align: center;
    text-decoration: none;
    color: var(--color-wit);
    transition: background-color 0.18s var(--ease-klap);
  }
  .snelknop:hover { background: color-mix(in srgb, var(--color-wit) 8%, transparent); }
  .snelknop-label {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .snelknop-uitleg { display: none; font-size: var(--text-klein); color: var(--color-grijs); }

  @media (min-width: 620px) {
    .snelknop { padding: 1.1rem 1.5rem; }
    .snelknop-label { font-size: 1.35rem; }
    .snelknop-uitleg { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-lid, .hero-lid-pijl, .snelknop { transition: none; }
    .hero-lid:hover, .hero-lid:hover .hero-lid-pijl { transform: none; }
  }

  /* ------------------------------------------------------------------ */
  /* Secties                                                            */
  /* ------------------------------------------------------------------ */
  .sectiekop {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.5rem;
  }

  .nieuwsraster {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }
  /* Op een telefoon geen vier hoge kaarten onder elkaar maar vier lage
     blokjes met een klein vierkant beeld. Het nieuws blijft compleet, het duwt
     alleen niet meer alles eronder van het scherm af. De omkadering zit in de
     kaart zelf, dus hier alleen nog de tussenruimte. */
  @media (max-width: 639px) {
    .nieuwsraster { gap: 0.7rem; }
  }
  @media (min-width: 640px) { .nieuwsraster { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .nieuwsraster { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .tweeluik { display: grid; gap: 3rem; }
  @media (min-width: 900px) {
    .tweeluik { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 3.5rem; }
  }

  /* Mozaiek: op een telefoon de grote foto bovenaan en de rest eronder, op
     een breed scherm de kantine als groot vlak links en drie kleinere
     rechts. */
  .mozaiek {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mozaiek-groot, .mozaiek-breed { grid-column: 1 / -1; }
  .mozaiek li { overflow: hidden; border-radius: var(--radius-vlak); }
  .mozaiek :global(img) {
    transition: transform 0.6s var(--ease-klap);
  }
  .mozaiek li:hover :global(img) { transform: scale(1.03); }

  @media (min-width: 900px) {
    .mozaiek {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      aspect-ratio: 2.2 / 1;
    }
    .mozaiek-groot { grid-column: 1 / 3; grid-row: 1 / 3; }
    .mozaiek-breed { grid-column: 3 / 5; grid-row: 1; }
    .mozaiek :global(img) {
      height: 100%;
      aspect-ratio: auto !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mozaiek :global(img) { transition: none; }
    .mozaiek li:hover :global(img) { transform: none; }
  }

  /* De carousel staat tussen twee haarlijnen. De ruimte boven de bovenste en
     onder de onderste is dezelfde waarde, anders hangt het spoor scheef in
     zijn eigen band. Dat was het geval: 1,25rem erboven tegen 3,5rem eronder. */
  .sponsors {
    --sponsors-ruimte: clamp(1.75rem, 3vw, 2.5rem);
    padding-block: clamp(2.5rem, 4vw, 3.5rem) var(--sponsors-ruimte);
  }
  /* Gelijk aan .sectiekop hierboven, op de ruimte eronder na: die moet even
     groot zijn als de ruimte onder de carousel. */
  .sponsors-kop {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: var(--sponsors-ruimte);
  }
</style>
