---
/**
 * Ereleden en leden van verdienste.
 *
 * Alleen namen, want meer heeft de club niet aangeleverd en meer is ook niet
 * nodig. Een erelijst hoort een erelijst te zijn: groot gezet, rustig, en
 * niet weggestopt in een tabel.
 */
import Basis from '../../layouts/Basis.astro';
import Paginakop from '../../components/Paginakop.astro';
import { getEreleden } from '../../lib/club';

const alle = getEreleden();
const ereleden = alle.filter((l) => l.soort === 'erelid' && !l.overleden);
const overleden = alle.filter((l) => l.soort === 'erelid' && l.overleden);
const verdienste = alle.filter((l) => l.soort === 'lid-van-verdienste');
---

<Basis
  titel="Ereleden"
  omschrijving="De ereleden en leden van verdienste van v.v. Kwiek '78."
>
  <Paginakop
    kicker="Club"
    titel="Ereleden"
    intro="Mensen zonder wie deze club er anders uit had gezien. Hun namen staan ook op het bord in de kantine."
  />

  <section class="vlak-wit sectie">
    <div class="omhulsel eregalerij">
      <section>
        <h2 class="kop-sectie eer-kop">Ereleden</h2>
        <ul class="namen">
          {ereleden.map((lid) => <li>{lid.naam}</li>)}
        </ul>
      </section>

      <section>
        <h2 class="kop-sectie eer-kop">In herinnering</h2>
        <p class="eer-uitleg">
          Ereleden van Kwiek '78 die zijn overleden. Zij blijven op de lijst staan.
        </p>
        <ul class="namen namen--stil">
          {overleden.map((lid) => (
            <li>{lid.naam} <span class="kruis" aria-label="overleden">&#8224;</span></li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="kop-sectie eer-kop">Leden van verdienste</h2>
        <ul class="namen">
          {verdienste.map((lid) => (
            <li>
              {lid.naam}
              {lid.overleden && <span class="kruis" aria-label="overleden"> &#8224;</span>}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </section>
</Basis>

<style>
  .eregalerij { display: grid; gap: 3rem; }

  .eer-kop {
    padding-bottom: 0.9rem;
    border-bottom: 2px solid var(--color-zwart);
    margin-bottom: 1.25rem;
  }
  .eer-uitleg {
    font-size: var(--text-klein);
    color: var(--color-grijsdonker);
    max-width: 58ch;
    margin: -0.5rem 0 1.25rem;
  }

  .namen {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.55rem 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .namen li {
    font-family: var(--font-smal);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .namen--stil li { color: var(--color-grijsdonker); font-weight: 600; }
  .kruis { color: var(--color-blauwdiep); }
</style>
