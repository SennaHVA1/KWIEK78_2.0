---
/**
 * Het minutenspel: negentig minuten in negentig dichte enveloppen, 25 euro
 * per stuk. Valt het eerste Kwiek-doelpunt van een thuiswedstrijd van Heren-1
 * of Vrouwen-1 in jouw minuut, dan win je de pot van 50 euro. Wordt er niet
 * gescoord, dan schuift de pot door, tot maximaal 150 euro.
 *
 * De speluitleg is aangeleverd door de club (seizoen 2026-2027).
 *
 * Het raster is bewust een raster en geen tabel: negentig genummerde vakjes
 * naast elkaar lezen sneller dan negentig regels onder elkaar.
 */
import Basis from '../../layouts/Basis.astro';
import Paginakop from '../../components/Paginakop.astro';
import { getMinutenspel, getMinutenspelStand, getContactpersoon } from '../../lib/club';

const minuten = getMinutenspel();
const stand = getMinutenspelStand();
const penningmeester = getContactpersoon('Penningmeester');

const kort = [
  { getal: '€ 25', wat: 'per minuut, voor het hele seizoen' },
  { getal: '€ 50', wat: 'voor het eerste Kwiek-doelpunt in jouw minuut' },
  { getal: '€ 150', wat: 'de hoogste pot, na twee thuiswedstrijden zonder Kwiek-doelpunt' },
];
---

<Basis
  titel="Minutenspel"
  omschrijving="Het minutenspel van v.v. Kwiek '78: voor 25 euro een minuut, en valt het eerste Kwiek-doelpunt van Heren-1 of Vrouwen-1 thuis in jouw minuut, dan win je 50 euro."
>
  <Paginakop
    foto="/images/club/kaart-sportpark.webp"
    fotoPositie="center 50%"
    kicker="Sponsoring"
    titel="Minutenspel"
    intro="Voor 25 euro een minuut, het hele seizoen. Scoort Kwiek '78 thuis het eerste doelpunt in jouw minuut, dan win je 50 euro."
  />

  <section class="vlak-wit sectie">
    <div class="omhulsel">
      <div class="kolom">
        <p class="kolom-kicker">Seizoen 2026-2027</p>

        <div class="uitleg">
          <div class="lopende-tekst">
            <h3>Wat kost een minuut?</h3>
            <p>
              Voor 25 euro ben je eigenaar van een minuut, voor alle competitiewedstrijden die
              Heren-1 en Vrouwen-1 dit seizoen thuis spelen. Dat zijn er dertien per team, en je
              speelt ze allemaal met dezelfde minuut.
            </p>
            <p>
              Om iedereen een eerlijke kans te geven wordt je minuut uit een tomboladoos getrokken.
              Er zijn negentig enveloppen, een voor elke minuut. De envelop is dicht, dus je weet
              vooraf niet welke minuut je krijgt.
            </p>

            <h3>De trekking</h3>
            <p>
              De trekking voor dit seizoen is geweest, op donderdagavond 17 september in de
              kantine. Voor wie er niet bij kon zijn, is de minuut getrokken in het bijzijn van de
              voltallige PR-commissie en doorgegeven per mail. Alle negentig minuten zijn verkocht; hieronder zie je wie welke minuut heeft.
            </p>

            <h3>Wat win je?</h3>
            <p>
              Scoort Heren-1 of Vrouwen-1 in een thuiswedstrijd het eerste doelpunt in jouw minuut,
              dan win je 50 euro. Het gaat alleen om het eerste doelpunt van Kwiek '78: wint Kwiek
              met 5-1, dan telt alleen de eerste treffer. Verliest Kwiek met 3-1, dan wordt er
              uitgekeerd voor dat ene Kwiek-doelpunt.
            </p>
            <p>
              Scoort Kwiek niet, dan wordt er die wedstrijd niets uitgekeerd en gaat de pot door
              naar de volgende wedstrijd, net zo lang tot er wel gescoord wordt. Na twee
              thuiswedstrijden zonder Kwiek-doelpunt is de pot in de derde wedstrijd 150 euro.
              Hoger wordt hij niet.
            </p>

            <h3>Wie bepaalt de minuut?</h3>
            <p>
              De scheidsrechter bepaalt in welke minuut het eerste doelpunt van Kwiek is gevallen.
              Wie de 45e of de 90e minuut heeft, krijgt de blessuretijd erbij. De lijsten hangen
              in de kantine en staan hieronder op de website.
            </p>
            <p>
              Met het minutenspel steun je de club, maak je kans op een prijs en wordt elke
              thuiswedstrijd van Heren-1 en Vrouwen-1 net even spannender.
            </p>
            {stand.vrij > 0 ? (
              <p>
                Meedoen? Vraag ernaar in de kantine, of stuur een bericht aan
                {penningmeester ? (
                  <a href={`mailto:${penningmeester.email}`}>{penningmeester.naam}</a>
                ) : 'de penningmeester'}.
              </p>
            ) : (
              <p>
                Volgend seizoen weer meedoen? Houd de website en de kantine in de gaten: voor de
                nieuwe trekking gaan de enveloppen opnieuw in de verkoop.
              </p>
            )}
          </div>

          <div class="zijkant">
            <ul class="kort">
              {kort.map((regel) => (
                <li>
                  <span class="kort-getal">{regel.getal}</span>
                  <span class="kort-wat">{regel.wat}</span>
                </li>
              ))}
            </ul>

            <div class="teller">
              <p class="teller-kop label">Verkochte minuten</p>
              <p class="teller-getal data">
                <span class="teller-verkocht">{stand.verkocht}</span>
                <span class="teller-van">van {stand.totaal}</span>
              </p>
              <div class="balk" role="img" aria-label={`${stand.verkocht} van ${stand.totaal} minuten verkocht`}>
                <span class="balk-vulling" style={`width:${(stand.verkocht / stand.totaal) * 100}%`}></span>
              </div>
              <p class="teller-vrij zacht">
                {stand.vrij > 0
                  ? `Nog ${stand.vrij} ${stand.vrij === 1 ? 'envelop' : 'enveloppen'} over, 25 euro per stuk.`
                  : 'Uitverkocht. De trekking was op 17 september.'}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="baan" aria-hidden="true"></div>

  <section class="vlak-zwart sectie">
    <div class="omhulsel">
      <div class="kolom">
        <p class="kolom-kicker">De lijst</p>
        <div>
          <div class="bordkop">
            <h2 class="kop-sectie">Wie heeft welke minuut</h2>
            {stand.vrij > 0 && (
              <p class="legenda">
                <span class="legenda-item"><span class="legenda-vlak legenda-vlak--vrij"></span> niet verkocht</span>
                <span class="legenda-item"><span class="legenda-vlak legenda-vlak--bezet"></span> verkocht</span>
              </p>
            )}
          </div>

          <ol class="minutenbord">
            {minuten.map((regel) => (
              <li class:list={['minuut', regel.naam ? 'is-bezet' : 'is-vrij']}>
                <span class="minuut-nummer data">{regel.minuut}{(regel.minuut === 45 || regel.minuut === 90) && '+'}</span>
                <span class="minuut-naam">{regel.naam ?? 'niet verkocht'}</span>
              </li>
            ))}
          </ol>
          <p class="bord-noot">De 45e en de 90e minuut krijgen de blessuretijd erbij.</p>
        </div>
      </div>
    </div>
  </section>
</Basis>

<style>
  .uitleg { display: grid; gap: 2.25rem; }
  @media (min-width: 900px) {
    .uitleg { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 3.5rem; align-items: start; }
  }

  .zijkant { display: grid; gap: 1rem; }

  .kort {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 1.5rem;
    border-radius: var(--radius-vlak);
    background: var(--color-zwart);
    color: var(--color-wit);
  }
  .kort li { display: grid; gap: 0.1rem; }
  .kort-getal {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.05;
    color: var(--color-blauw);
  }
  .kort-wat { font-size: var(--text-klein); color: var(--color-grijs); line-height: 1.45; }

  .teller {
    display: grid;
    gap: 0.6rem;
    border-radius: var(--radius-vlak);
    background: var(--kleur-papier-diep);
    padding: 1.5rem;
  }
  .teller-getal { display: flex; align-items: baseline; gap: 0.5rem; }
  .teller-verkocht { font-size: 2.75rem; font-weight: 700; line-height: 1; color: var(--color-blauwdiep); }
  .teller-van { font-size: var(--text-klein); color: var(--color-grijsdonker); }

  .balk { height: 6px; background: color-mix(in srgb, var(--color-zwart) 12%, transparent); }
  .balk-vulling { display: block; height: 100%; background: var(--color-blauwdiep); }

  .teller-vrij { font-size: var(--text-klein); }

  /* Bord -------------------------------------------------------------- */
  .bordkop {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.25rem;
  }
  .legenda { display: flex; gap: 1.25rem; }
  .legenda-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-smal);
    font-size: var(--text-mini);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-grijs);
  }
  .legenda-vlak { width: 0.75rem; height: 0.75rem; }
  .legenda-vlak--vrij { border: 1px solid var(--kleur-lijn-donker); }
  .legenda-vlak--bezet { background: color-mix(in srgb, var(--color-blauw) 25%, transparent); border: 1px solid var(--color-blauw); }

  .minutenbord {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 1px;
    background: var(--kleur-lijn-donker);
    border: 1px solid var(--kleur-lijn-donker);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .minuut {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.7rem;
    background: var(--color-zwart);
    min-height: 3.75rem;
    align-content: center;
  }
  .minuut-nummer {
    font-size: var(--text-mini);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-grijs);
  }
  .minuut-naam {
    font-size: var(--text-klein);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .is-bezet { background: color-mix(in srgb, var(--color-blauw) 14%, var(--color-zwart)); }
  .is-bezet .minuut-nummer { color: var(--color-blauw); }
  .is-vrij .minuut-naam {
    color: var(--color-grijs);
    font-weight: 400;
    font-style: italic;
  }

  .bord-noot { margin-top: 1rem; font-size: var(--text-klein); color: var(--color-grijs); }
</style>
