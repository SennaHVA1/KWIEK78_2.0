---
/**
 * Het programma: alle wedstrijden die nog gespeeld moeten worden,
 * gegroepeerd per speeldag en filterbaar op team en op thuis of uit.
 */
import Basis from '../../layouts/Basis.astro';
import Paginakop from '../../components/Paginakop.astro';
import Filterbalk from '../../components/Filterbalk.astro';
import Wedstrijdlijst from '../../components/Wedstrijdlijst.astro';
import { getProgramma, getWedstrijdTeams } from '../../lib/sportlink';

const wedstrijden = getProgramma();
const teams = getWedstrijdTeams();
const afgelast = wedstrijden.filter((w) => w.afgelast).length;

const filters = [
  {
    sleutel: 'team',
    label: 'Team',
    opties: teams.map((naam) => ({ waarde: naam, label: naam.replace("Kwiek '78 ", '') })),
  },
  {
    sleutel: 'locatie',
    label: 'Thuis of uit',
    opties: [
      { waarde: 'thuis', label: 'Thuis' },
      { waarde: 'uit', label: 'Uit' },
    ],
  },
  {
    sleutel: 'soort',
    label: 'Soort',
    opties: [
      { waarde: 'competitie', label: 'Competitie' },
      { waarde: 'beker', label: 'Beker' },
      { waarde: 'oefen', label: 'Oefen' },
      { waarde: 'zaal', label: 'Zaal' },
    ],
  },
];
---

<Basis
  titel="Programma"
  omschrijving="Alle komende wedstrijden van v.v. Kwiek '78, per speeldag en filterbaar op team en op thuis of uit."
>
  <Paginakop
    kicker="Wedstrijden"
    titel="Programma"
    intro="Alle wedstrijden die nog gespeeld moeten worden. Filter op het team van je kind en je hebt in een oogopslag de zaterdag of zondag."
  />

  <section class="vlak-wit sectie">
    <div class="omhulsel">
      {/* In dezelfde kolom als de wedstrijdrijen, zodat de filters netjes
          boven de lijst uitlijnen in plaats van ernaast te beginnen. */}
      <div class="kolom filterkolom">
        <p class="kolom-kicker">Filteren</p>
        <div>
          {afgelast > 0 && (
            <p class="melding">
              <span class="merk merk--afgelast">Let op</span>
              {afgelast === 1
                ? 'Er staat een afgelaste wedstrijd in dit programma.'
                : `Er staan ${afgelast} afgelaste wedstrijden in dit programma.`}
              Afgelaste wedstrijden zijn doorgestreept en blauw gearceerd.
            </p>
          )}
          <Filterbalk groepen={filters} />
        </div>
      </div>

      <Wedstrijdlijst
        wedstrijden={wedstrijden}
        leegTekst="Het programma is nog niet bekend. Zodra de KNVB de indeling publiceert staat hij hier."
      />
    </div>
  </section>
</Basis>

<style>
  .melding {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-size: var(--text-klein);
    border-left: 3px solid var(--color-blauwdiep);
    padding: 0.7rem 0.9rem;
    background: color-mix(in srgb, var(--color-blauwdiep) 8%, transparent);
    margin-bottom: 1.75rem;
    max-width: 70ch;
  }
  .filterkolom { margin-bottom: 0.5rem; }
</style>
