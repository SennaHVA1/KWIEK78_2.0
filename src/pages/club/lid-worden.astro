---
/**
 * Lid worden en lidmaatschap wijzigen, op een pagina met een tabwissel.
 *
 * Op de oude site waren dit twee losse pagina's, terwijl het dezelfde
 * handeling is bij dezelfde ledenadministratie.
 *
 * Beide formulieren gaan via Web3Forms als e-mail naar de ledenadministratie
 * (zie src/lib/web3forms.ts). Zonder sleutel staan ze in de demostand.
 *
 * Het aanmeldformulier vraagt hetzelfde als het formulier van de oude site,
 * in dezelfde volgorde, zodat de ledenadministratie niets nieuws hoeft te
 * leren. Een IBAN vragen we niet: dat zou dan als gewone mail binnenkomen.
 */
import Basis from '../../layouts/Basis.astro';
import Paginakop from '../../components/Paginakop.astro';
import { getContactpersoon, CLUBGEGEVENS } from '../../lib/club';
import { isActief } from '../../lib/web3forms';

const ledenadministratie = getContactpersoon('Ledenadministratie');

/* Zolang er geen Web3Forms-sleutel voor de ledenadministratie is, verstuurt
   het eigen formulier niets. Nieuwe leden schrijven zich dan in via de pagina
   van de KNVB. */
const AANMELDEN_VIA_KNVB = !isActief('leden');
const knvbInschrijven = `https://www.knvb.nl/ontdek-voetbal/inschrijven/${CLUBGEGEVENS.knvbClubcode}`;

/* De soorten lidmaatschap, zoals de club ze in Sportlink heeft staan. */
const lidmaatschappen = [
  { naam: 'Voetbal: Algemeen/Futsal', uitleg: 'Tevens bondslid KNVB' },
  { naam: 'Voetbal: Algemeen/Veld', uitleg: 'Tevens bondslid KNVB' },
  { naam: 'Niet spelend', uitleg: 'Bijvoorbeeld trainers en scheidsrechters. Tevens bondslid KNVB' },
  { naam: 'Vereniging', uitleg: 'Voor als je niet in de KNVB-competitie wilt spelen' },
];

/* Op welke dag iemand een dagdeel in de kantine wil staan. Niets aanvinken
   mag ook. */
const kantinedagen = ['Zaterdag', 'Zondag'];

const fluiten = ['Scheidsrechter', 'Spelbegeleider', 'Liever niet'];

/* Keuzelijst voor de nationaliteit. Een vrij veld met suggesties, want een
   volledige lijst van alle landen is voor deze club overdreven. */
const nationaliteiten = [
  'Nederlands', 'Belgisch', 'Duits', 'Pools', 'Turks', 'Marokkaans', 'Surinaams',
  'Brits', 'Oekraïens', 'Roemeens', 'Bulgaars', 'Portugees', 'Spaans', 'Italiaans', 'Syrisch',
];
---

<Basis
  titel="Lid worden"
  omschrijving="Aanmelden als lid van v.v. Kwiek '78 of een bestaand lidmaatschap wijzigen."
>
  <Paginakop
    foto="/images/club/kaart-sportpark.webp"
    fotoPositie="center 50%"
    kicker="Club"
    titel="Lid worden"
    intro="Aanmelden of iets wijzigen aan een bestaand lidmaatschap. Beide gaan naar dezelfde ledenadministratie."
  />

  <section class="vlak-wit sectie">
    <div class="omhulsel">
      {!isActief('leden') && (
        <p class="demo-melding">
          <span class="merk merk--zacht">Demo</span>
          De formulieren op deze pagina zijn nog niet aangesloten. Ze laten wel precies zien
          welke gegevens er straks gevraagd worden.
        </p>
      )}

      <!-- ============================================================== -->
      <!-- Tabwissel                                                      -->
      <!-- ============================================================== -->
      <div class="tabs" data-tabs>
        <div class="tablijst" role="tablist" aria-label="Kies wat je wilt doen">
          <button
            type="button"
            role="tab"
            id="tab-aanmelden"
            aria-controls="paneel-aanmelden"
            aria-selected="true"
            class="tab is-gekozen"
          >Aanmelden als lid</button>
          <button
            type="button"
            role="tab"
            id="tab-wijzigen"
            aria-controls="paneel-wijzigen"
            aria-selected="false"
            tabindex="-1"
            class="tab"
          >Lidmaatschap wijzigen</button>
        </div>

        <!-- ------------------------------------------------------------ -->
        <!-- Aanmelden                                                    -->
        <!-- ------------------------------------------------------------ -->
        <div role="tabpanel" id="paneel-aanmelden" aria-labelledby="tab-aanmelden" tabindex="0" class="paneel">
          <div class="paneel-binnen">
            <div class="paneel-tekst">
              <h2 class="kop-sectie">Aanmelden als lid</h2>
              <div class="lopende-tekst">
                <p>
                  Nieuwe leden zijn welkom, van vijf jaar tot vijfenzestig plus.
                  Je mag altijd eerst drie keer meetrainen voordat je beslist.
                </p>
                <h3>Hoe het daarna gaat</h3>
                <ol>
                  <li>{AANMELDEN_VIA_KNVB ? 'Je schrijft je in via de KNVB.' : 'Je vult dit formulier in.'}</li>
                  <li>De ledenadministratie neemt binnen een week contact op.</li>
                  <li>Je wordt ingedeeld bij een team en krijgt de trainingstijden.</li>
                  <li>Contributiepartner NIKKI stuurt je het betaalverzoek. Je betaalt in een keer of in delen.</li>
                </ol>
                <p>
                  Was je eerder lid van een andere vereniging? Dan hebben we je relatiecode nodig
                  voor de overschrijving bij de KNVB.
                </p>
              </div>
            </div>

            {AANMELDEN_VIA_KNVB ? (
            <div class="knvb-inschrijven">
              <p>
                Inschrijven gaat via de site van de KNVB. Daar vul je je gegevens in en je
                aanmelding komt direct bij onze ledenadministratie terecht.
              </p>
              <a class="knop knop--zwart" href={knvbInschrijven} target="_blank" rel="noopener noreferrer">
                Inschrijven bij de KNVB
              </a>
            </div>
            ) : (
            <form class="formulier" data-formulier data-sleutel="leden" data-onderwerp="Nieuwe aanmelding als lid" data-bedankt="Bedankt voor je aanmelding! De ledenadministratie neemt binnen een week contact met je op." novalidate>
              {/* Lidmaatschap ------------------------------------------- */}
              <fieldset class="keuzegroep veld" data-groep-verplicht>
                <legend>Lidmaatschap</legend>
                <p class="veld-hulp">
                  Kies de sport of activiteit die je bij Kwiek '78 wilt gaan doen. Meer dan een mag.
                </p>
                <div class="tegels tegels--breed">
                  {lidmaatschappen.map((soort) => (
                    <label class="tegel">
                      <input type="checkbox" name="lidmaatschap" value={soort.naam} />
                      <span class="tegel-naam">{soort.naam}</span>
                      <span class="tegel-uitleg">{soort.uitleg}</span>
                    </label>
                  ))}
                </div>
                <p class="veld-fout" data-fout hidden>Kies minimaal een soort lidmaatschap.</p>
              </fieldset>

              {/* Vorige vereniging --------------------------------------- */}
              <fieldset class="keuzegroep veld">
                <legend>Voormalige of huidige vereniging</legend>
                <p class="veld-hulp">
                  Ben je al eerder lid geweest, of ben je nog lid, van een vereniging die is aangesloten
                  bij de KNVB?
                </p>
                <div class="tegels">
                  <label class="tegel">
                    <input type="radio" name="eerderlid" value="Ja" required data-vorige-ja />
                    <span class="tegel-naam">Ja</span>
                  </label>
                  <label class="tegel">
                    <input type="radio" name="eerderlid" value="Nee" required />
                    <span class="tegel-naam">Nee</span>
                  </label>
                </div>
                <p class="veld-fout" data-fout hidden>Kies ja of nee.</p>
              </fieldset>

              <div class="veldrij" data-vorige-velden hidden>
                <div class="veld">
                  <label for="vorigevereniging">Naam vereniging</label>
                  <input type="text" id="vorigevereniging" name="vorigevereniging" disabled />
                </div>
                <div class="veld">
                  <label for="relatiecodevorigevereniging">KNVB-relatiecode</label>
                  <input type="text" id="relatiecodevorigevereniging" name="relatiecodevorigevereniging" disabled />
                  <p class="veld-hulp">Als je die weet. Staat in de KNVB-app onder je profiel.</p>
                </div>
              </div>

              {/* Je gegevens ---------------------------------------------- */}
              <h3 class="formulier-tussenkop">Je gegevens</h3>

              <fieldset class="keuzegroep veld">
                <legend>Geslacht</legend>
                <div class="tegels">
                  <label class="tegel">
                    <input type="radio" name="geslacht" value="Man" required />
                    <span class="tegel-naam">Man</span>
                  </label>
                  <label class="tegel">
                    <input type="radio" name="geslacht" value="Vrouw" required />
                    <span class="tegel-naam">Vrouw</span>
                  </label>
                </div>
                <p class="veld-fout" data-fout hidden>Maak een keuze.</p>
              </fieldset>

              <div class="veldrij">
                <div class="veld">
                  <label for="voornaam">Voornaam</label>
                  <input type="text" id="voornaam" name="voornaam" autocomplete="given-name" />
                </div>
                <div class="veld">
                  <label for="voorletters">Voorletter(s)</label>
                  <input type="text" id="voorletters" name="voorletters" placeholder="J.P." required />
                  <p class="veld-fout" data-fout hidden>Vul je voorletters in.</p>
                </div>
              </div>

              <div class="veldrij veldrij--drie-omgekeerd">
                <div class="veld">
                  <label for="tussenvoegsel">Tussenvoegsel(s)</label>
                  <input type="text" id="tussenvoegsel" name="tussenvoegsel" autocomplete="additional-name" />
                </div>
                <div class="veld">
                  <label for="achternaam">Achternaam</label>
                  <input type="text" id="achternaam" name="achternaam" autocomplete="family-name" required />
                  <p class="veld-fout" data-fout hidden>Vul een achternaam in.</p>
                </div>
              </div>

              <datalist id="nationaliteiten">
                {nationaliteiten.map((n) => <option value={n} />)}
              </datalist>
              <div class="veldrij">
                <div class="veld">
                  <label for="nationaliteit">Nationaliteit</label>
                  <input type="text" id="nationaliteit" name="nationaliteit" list="nationaliteiten" value="Nederlands" required />
                  <p class="veld-fout" data-fout hidden>Vul je nationaliteit in.</p>
                </div>
                <div class="veld">
                  <label for="nationaliteit2">2e nationaliteit</label>
                  <input type="text" id="nationaliteit2" name="nationaliteit2" list="nationaliteiten" />
                </div>
              </div>

              <div class="veld">
                <label for="geboortedatum">Geboortedatum</label>
                <input type="date" id="geboortedatum" name="geboortedatum" autocomplete="bday" required />
                <p class="veld-fout" data-fout hidden>Vul een geboortedatum in.</p>
              </div>

              {/* Adres ---------------------------------------------------- */}
              <h3 class="formulier-tussenkop">Adres</h3>

              <div class="veld">
                <label for="land">Land</label>
                <input type="text" id="land" name="land" autocomplete="country-name" value="Nederland" required />
                <p class="veld-fout" data-fout hidden>Vul een land in.</p>
              </div>

              <div class="veldrij">
                <div class="veld">
                  <label for="postcode">Postcode</label>
                  <input type="text" id="postcode" name="postcode" autocomplete="postal-code" placeholder="1633 DH" required />
                  <p class="veld-fout" data-fout hidden>Vul een postcode in.</p>
                </div>
                <div class="veldrij veldrij--paar">
                  <div class="veld">
                    <label for="huisnummer">Huisnummer</label>
                    <input type="text" id="huisnummer" name="huisnummer" inputmode="numeric" required />
                    <p class="veld-fout" data-fout hidden>Vul een huisnummer in.</p>
                  </div>
                  <div class="veld">
                    <label for="toevoeging">Toevoeging</label>
                    <input type="text" id="toevoeging" name="toevoeging" />
                  </div>
                </div>
              </div>

              <div class="veldrij">
                <div class="veld">
                  <label for="straat">Straatnaam</label>
                  <input type="text" id="straat" name="straat" autocomplete="address-line1" required />
                  <p class="veld-fout" data-fout hidden>Vul een straatnaam in.</p>
                </div>
                <div class="veld">
                  <label for="woonplaats">Woonplaats</label>
                  <input type="text" id="woonplaats" name="woonplaats" autocomplete="address-level2" required />
                  <p class="veld-fout" data-fout hidden>Vul een woonplaats in.</p>
                </div>
              </div>

              {/* Contact -------------------------------------------------- */}
              <h3 class="formulier-tussenkop">Contact</h3>

              <div class="veldrij">
                <div class="veld">
                  <label for="telefoonvast">Telefoon vast</label>
                  <input type="tel" id="telefoonvast" name="telefoonvast" autocomplete="tel" inputmode="tel" />
                </div>
                <div class="veld">
                  <label for="telefoonmobiel">Telefoon mobiel</label>
                  <input type="tel" id="telefoonmobiel" name="telefoonmobiel" autocomplete="tel" inputmode="tel" />
                  <p class="veld-hulp">Bij jeugdleden het nummer van een ouder of verzorger.</p>
                </div>
              </div>

              <div class="veldrij">
                <div class="veld">
                  <label for="emailadres">E-mail</label>
                  <input type="email" id="emailadres" name="emailadres" autocomplete="email" required />
                  <p class="veld-fout" data-fout hidden>Vul een geldig e-mailadres in.</p>
                </div>
                <div class="veld">
                  <label for="emailherhaal">Herhaal e-mail</label>
                  <input type="email" id="emailherhaal" name="emailherhaal" autocomplete="email" required data-herhaal="emailadres" />
                  <p class="veld-fout" data-fout hidden>Dit is niet hetzelfde e-mailadres.</p>
                </div>
              </div>

              {/* Overige vragen ------------------------------------------- */}
              <h3 class="formulier-tussenkop">Overige vragen</h3>

              <fieldset class="keuzegroep">
                <legend>Ik wil een dagdeel kantinedienst draaien</legend>
                <div class="tegels">
                  {kantinedagen.map((dag) => (
                    <label class="tegel">
                      <input type="checkbox" name="kantinedienst" value={dag} />
                      <span class="tegel-naam">Op {dag.toLowerCase()}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <fieldset class="keuzegroep">
                <legend>Ik wil scheidsrechter of spelbegeleider worden</legend>
                <div class="tegels tegels--drie">
                  {fluiten.map((keuze) => (
                    <label class="tegel">
                      <input type="radio" name="scheidsrechter" value={keuze} />
                      <span class="tegel-naam">{keuze}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="veld">
                <label for="opmerkingen">Opmerkingen</label>
                <textarea id="opmerkingen" name="opmerkingen" rows="5" maxlength="1000"></textarea>
                <p class="veld-hulp">
                  Heb je een voorkeur voor de spelvorm, het team waar je graag in wilt spelen, of iets anders
                  voor de ledenadministratie? Zet het hier. Maximaal 1000 tekens.
                </p>
              </div>

              {/* Privacy -------------------------------------------------- */}
              <fieldset class="akkoorden">
                <legend>Privacyverklaringen</legend>
                <p class="veld-hulp">
                  Lees de privacyverklaringen van Kwiek '78 en de KNVB voordat je je aanmeldt. Daarin staat
                  hoe de club en de KNVB met je persoonsgegevens omgaan.
                </p>
                <div class="veld veld--vinkje">
                  <label class="vinkje">
                    <input type="checkbox" name="akkoordprivacy" required />
                    <span>
                      Ik heb de <a href="/privacyverklaring" target="_blank">privacyverklaring van Kwiek '78</a>
                      en de <a href="https://www.knvb.nl/info/3043/privacy" target="_blank" rel="noopener noreferrer">privacyverklaring van de KNVB</a>
                      gelezen.
                    </span>
                  </label>
                  <p class="veld-fout" data-fout hidden>Zonder akkoord kunnen we de aanmelding niet verwerken.</p>
                </div>
              </fieldset>

              <p class="formulier-melding" data-melding role="status" hidden></p>

              <button type="submit" class="knop knop--zwart">Aanmelding versturen</button>
            </form>
            )}
          </div>
        </div>

        <!-- ------------------------------------------------------------ -->
        <!-- Wijzigen                                                     -->
        <!-- ------------------------------------------------------------ -->
        <div role="tabpanel" id="paneel-wijzigen" aria-labelledby="tab-wijzigen" tabindex="0" class="paneel" hidden>
          <div class="paneel-binnen">
            <div class="paneel-tekst">
              <h2 class="kop-sectie">Lidmaatschap wijzigen</h2>
              <div class="lopende-tekst">
                <p>
                  Verhuisd, ander rekeningnummer, of stoppen? Geef het hier door.
                  Alles komt bij dezelfde persoon terecht.
                </p>
                <h3>Let op bij opzeggen</h3>
                <p>
                  Opzeggen kan tot en met 31 mei. Zeg je later op, dan is de club de KNVB-afdracht
                  voor het nieuwe seizoen al kwijt en brengen we die in rekening.
                  Dat staat ook in het huishoudelijk reglement.
                </p>
                {ledenadministratie?.email && (
                  <p>
                    Liever even mailen? Dat kan naar{' '}
                    <a href={`mailto:${ledenadministratie.email}`}>{ledenadministratie.email}</a>.
                  </p>
                )}
              </div>
            </div>

            <form class="formulier" data-formulier data-sleutel="leden" data-onderwerp="Wijziging lidmaatschap" data-bedankt="Bedankt, je wijziging is doorgegeven aan de ledenadministratie." novalidate>
              <div class="veld">
                <label for="wnaam">Naam van het lid</label>
                <input type="text" id="wnaam" name="naam" autocomplete="name" required />
                <p class="veld-fout" data-fout hidden>Vul de naam van het lid in.</p>
              </div>

              <div class="veldrij">
                <div class="veld">
                  <label for="wrelatiecode">KNVB-relatiecode</label>
                  <input type="text" id="wrelatiecode" name="relatiecode" />
                  <p class="veld-hulp">Handig maar niet verplicht. Staat in de KNVB-app.</p>
                </div>
                <div class="veld">
                  <label for="wemail">E-mailadres</label>
                  <input type="email" id="wemail" name="emailadres" autocomplete="email" required />
                  <p class="veld-fout" data-fout hidden>Vul een geldig e-mailadres in.</p>
                </div>
              </div>

              <div class="veld">
                <label for="wsoort">Wat wil je wijzigen?</label>
                <select id="wsoort" name="soort" required>
                  <option value="">Kies een wijziging</option>
                  <option value="adres">Adreswijziging</option>
                  <option value="bank">Ander rekeningnummer</option>
                  <option value="contact">Ander e-mailadres of telefoonnummer</option>
                  <option value="vorm">Andere lidmaatschapsvorm</option>
                  <option value="team">Verzoek tot ander team</option>
                  <option value="opzegging">Opzegging</option>
                </select>
                <p class="veld-fout" data-fout hidden>Maak een keuze.</p>
              </div>

              <div class="veld">
                <label for="wingang">Gewenste ingangsdatum</label>
                <input type="date" id="wingang" name="ingangsdatum" />
                <p class="veld-hulp">Laat leeg als het zo snel mogelijk moet ingaan.</p>
              </div>

              <div class="veld">
                <label for="wtoelichting">Toelichting</label>
                <textarea id="wtoelichting" name="toelichting" rows="5" required></textarea>
                <p class="veld-hulp">Bij een adreswijziging: het nieuwe adres. Bij een opzegging: kort de reden, dat helpt de club.</p>
                <p class="veld-fout" data-fout hidden>Vul een toelichting in.</p>
              </div>

              <p class="formulier-melding" data-melding role="status" hidden></p>

              <button type="submit" class="knop knop--zwart">Wijziging doorgeven</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Basis>

<style>
  .demo-melding {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    font-size: var(--text-klein);
    color: var(--color-grijsdonker);
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-vlak);
    background: var(--kleur-papier-diep);
    margin-bottom: 2.25rem;
    max-width: 70ch;
  }

  /* Tabs -------------------------------------------------------------- */
  .tablijst {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--kleur-lijn-licht);
    margin-bottom: 2.25rem;
    overflow-x: auto;
  }
  .tab {
    background: none;
    border: 0;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    color: var(--color-grijsdonker);
    cursor: pointer;
    font-family: var(--font-smal);
    font-size: 1.3rem;
    font-weight: 700;
    padding: 0.75rem 1.1rem;
    white-space: nowrap;
    transition: color 0.15s var(--ease-klap), border-color 0.15s var(--ease-klap);
  }
  .tab:first-child { padding-left: 0; }
  .tab:hover { color: var(--color-zwart); }
  .tab.is-gekozen { color: var(--color-zwart); border-bottom-color: var(--color-blauwdiep); }
  .tablijst { border-bottom-width: 2px; }
  @media (prefers-reduced-motion: reduce) { .tab { transition: none; } }

  .paneel[hidden] { display: none; }
  .paneel:focus-visible { outline-offset: 6px; }

  .paneel-binnen { display: grid; gap: 2.5rem; }
  @media (min-width: 950px) {
    .paneel-binnen { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 4rem; align-items: start; }
    .paneel-tekst { position: sticky; top: 6rem; }
  }
  .paneel-tekst { display: grid; gap: 1rem; align-content: start; }

  /* Formulier --------------------------------------------------------- */
  .formulier { display: grid; gap: 1.25rem; max-width: 40rem; }
  .knvb-inschrijven {
    display: grid; gap: 1.25rem; justify-items: start; align-content: start;
    max-width: 40rem; padding: 1.5rem;
    border-radius: var(--radius-vlak);
    background: var(--kleur-papier-diep);
  }
  .veldrij { display: grid; gap: 1.25rem; align-items: start; }
  .veldrij[hidden] { display: none; }
  /* Huisnummer en toevoeging blijven ook op een telefoon naast elkaar. */
  .veldrij--paar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 560px) {
    .veldrij { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .veldrij--drie { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
    .veldrij--drie-omgekeerd { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
  }

  .formulier-tussenkop {
    font-family: var(--font-smal);
    font-size: var(--text-kop-s);
    font-weight: 700;
    color: var(--color-zwart);
    padding-top: 1.25rem;
    margin-top: 0.5rem;
    border-top: 1px solid var(--kleur-lijn-licht);
  }

  .akkoorden {
    border: 0;
    padding: 1.25rem 0 0;
    margin: 0.5rem 0 0;
    border-top: 1px solid var(--kleur-lijn-licht);
    display: grid;
    gap: 0.9rem;
  }
  .akkoorden legend {
    font-family: var(--font-smal);
    font-size: var(--text-kop-s);
    font-weight: 700;
    color: var(--color-zwart);
    padding: 0;
  }
  /* Het vinkje krijgt een gewone labeltekst, niet de mono-kop van de andere velden. */
  .veld--vinkje > :global(label.vinkje) {
    font-family: var(--font-sans);
    font-size: var(--text-klein);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: inherit;
  }
  .vinkje {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
    line-height: 1.55;
    cursor: pointer;
  }
  .vinkje input {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.15rem;
    accent-color: var(--color-blauwdiep);
  }

  /* Keuzes als aanklikbare tegels, twee naast elkaar. */
  .keuzegroep { border: 0; padding: 0; margin: 0; min-width: 0; }
  .keuzegroep legend {
    font-family: var(--font-smal);
    font-size: var(--text-kop-s);
    font-weight: 700;
    color: var(--color-zwart);
    padding: 0;
    margin-bottom: 0.25rem;
  }
  .tegels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 0.75rem;
  }
  .tegels--lijst { grid-template-columns: minmax(0, 1fr); }
  .tegels--drie { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  /* Tegels met een uitleg zijn op een telefoon te krap voor twee naast elkaar. */
  @media (max-width: 559px) {
    .tegels--breed, .tegels--drie { grid-template-columns: minmax(0, 1fr); }
  }
  .keuzegroep > .tegels > :global(label.tegel) {
    font-family: var(--font-sans);
    font-size: var(--text-klein);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: inherit;
  }
  .tegel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.65rem;
    align-items: center;
    padding: 0.75rem 0.9rem;
    border: 2px solid var(--kleur-lijn-licht);
    border-radius: var(--radius-vlak);
    cursor: pointer;
    transition: border-color 0.15s var(--ease-klap), background-color 0.15s var(--ease-klap);
  }
  .tegel:hover { border-color: color-mix(in srgb, var(--color-blauwdiep) 50%, transparent); }
  .tegel:has(input:checked) { border-color: var(--color-blauwdiep); background: var(--kleur-papier-op); }
  .tegel:has(input:focus-visible) { outline: 3px solid var(--color-blauwdiep); outline-offset: 2px; }
  .tegel input {
    grid-row: span 2;
    /* .veld input is bedoeld voor tekstvelden; voor een vinkje terugzetten. */
    width: 1.15rem;
    height: 1.15rem;
    min-height: 0;
    padding: 0;
    margin: 0;
    accent-color: var(--color-blauwdiep);
  }
  .tegel-naam { font-weight: 600; color: var(--color-zwart); }
  .tegel-uitleg { font-size: var(--text-mini); color: var(--color-grijsdonker); }
  @media (prefers-reduced-motion: reduce) { .tegel { transition: none; } }

  .formulier-melding {
    font-size: var(--text-klein);
    border-radius: var(--radius-vlak);
    background: var(--kleur-papier-diep);
    padding: 0.9rem 1.1rem;
    line-height: 1.55;
  }
  .formulier-melding[hidden] { display: none; }
</style>

<script>
  import { verstuurMetMelding, voegBotcheckToe } from '../../lib/web3forms';

  /* ------------------------------------------------------------------ */
  /* Tabwissel                                                        */
  /* Zelf geschreven, met de toetsenbordafspraken die bij een tablist    */
  /* horen: pijltjes wisselen, Home en End springen naar begin en eind.  */
  /* ------------------------------------------------------------------ */
  const tabhouder = document.querySelector<HTMLElement>('[data-tabs]');

  if (tabhouder) {
    const tabs = [...tabhouder.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

    const kies = (index: number, verplaatsFocus = true) => {
      tabs.forEach((tab, i) => {
        const gekozen = i === index;
        tab.setAttribute('aria-selected', String(gekozen));
        tab.tabIndex = gekozen ? 0 : -1;
        tab.classList.toggle('is-gekozen', gekozen);
        const paneel = document.getElementById(tab.getAttribute('aria-controls')!);
        if (paneel) paneel.hidden = !gekozen;
      });
      if (verplaatsFocus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => kies(i, false));
      tab.addEventListener('keydown', (gebeurtenis) => {
        const toets = gebeurtenis.key;
        if (toets === 'ArrowRight') kies((i + 1) % tabs.length);
        else if (toets === 'ArrowLeft') kies((i - 1 + tabs.length) % tabs.length);
        else if (toets === 'Home') kies(0);
        else if (toets === 'End') kies(tabs.length - 1);
        else return;
        gebeurtenis.preventDefault();
      });
    });
  }

  /* ------------------------------------------------------------------ */
  /* Validatie en versturen                                             */
  /* ------------------------------------------------------------------ */
  for (const formulier of document.querySelectorAll<HTMLFormElement>('[data-formulier]')) {
    const melding = formulier.querySelector<HTMLElement>('[data-melding]');
    voegBotcheckToe(formulier);

    /** Toont of verbergt de foutmelding die bij een veld hoort. */
    const toonFout = (veld: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      const fout = veld.closest('.veld')?.querySelector<HTMLElement>('[data-fout]');
      if (!fout) return;
      fout.hidden = veld.checkValidity();
    };

    /* Een groep vinkjes waarvan er minimaal een aan moet. HTML kan dat niet
       zelf, dus de vinkjes krijgen samen een eigen validatiemelding. */
    const groepen = [...formulier.querySelectorAll<HTMLElement>('[data-groep-verplicht]')];
    const controleerGroepen = () => {
      for (const groep of groepen) {
        const vinkjes = [...groep.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
        const melding = vinkjes.some((v) => v.checked) ? '' : 'Kies minimaal een optie.';
        vinkjes.forEach((v) => v.setCustomValidity(melding));
      }
    };
    controleerGroepen();

    /* Herhaal e-mail moet hetzelfde zijn als het eerste adres. */
    const herhaal = formulier.querySelector<HTMLInputElement>('[data-herhaal]');
    const origineel = herhaal
      ? formulier.querySelector<HTMLInputElement>(`[name="${herhaal.dataset.herhaal}"]`)
      : null;
    const controleerHerhaal = () => {
      if (!herhaal || !origineel) return;
      const gelijk = herhaal.value.trim().toLowerCase() === origineel.value.trim().toLowerCase();
      herhaal.setCustomValidity(gelijk ? '' : 'Niet hetzelfde e-mailadres.');
    };
    formulier.addEventListener('input', controleerHerhaal);

    /* De vorige vereniging alleen bij "ja". Uitgeschakelde velden gaan niet
       mee in de mail, dus wat er bij "nee" nog in stond verdwijnt vanzelf. */
    const vorigeJa = formulier.querySelector<HTMLInputElement>('[data-vorige-ja]');
    const vorigeVelden = formulier.querySelector<HTMLElement>('[data-vorige-velden]');
    const toonVorige = () => {
      if (!vorigeJa || !vorigeVelden) return;
      vorigeVelden.hidden = !vorigeJa.checked;
      vorigeVelden.querySelectorAll('input').forEach((veld) => (veld.disabled = !vorigeJa.checked));
    };

    formulier.addEventListener('change', (gebeurtenis) => {
      controleerGroepen();
      toonVorige();
      const doel = gebeurtenis.target;
      // Een fout bij een groep keuzes verdwijnt zodra er een is gekozen.
      if (doel instanceof HTMLInputElement && (doel.type === 'radio' || doel.closest('[data-groep-verplicht]'))) {
        toonFout(doel);
      }
    });

    formulier.addEventListener('submit', async (gebeurtenis) => {
      gebeurtenis.preventDefault();
      controleerGroepen();
      controleerHerhaal();

      const velden = [...formulier.querySelectorAll<HTMLInputElement>('input, select, textarea')];
      velden.forEach(toonFout);

      const eersteFout = velden.find((veld) => !veld.checkValidity());
      if (eersteFout) {
        eersteFout.focus();
        if (melding) {
          melding.hidden = false;
          melding.textContent = 'Er ontbreekt nog iets. De velden met een melding zijn nog niet in orde.';
        }
        return;
      }

      const gelukt = await verstuurMetMelding(
        formulier,
        melding,
        'Alles is correct ingevuld. In deze demo wordt er niets verstuurd; ' +
          'na oplevering gaat de aanmelding rechtstreeks naar de ledenadministratie.',
      );
      if (gelukt) {
        controleerGroepen();
        toonVorige();
      }
    });

    // Meteen na het verlaten van een veld terugkoppelen, niet al tijdens het typen.
    formulier.addEventListener('blur', (gebeurtenis) => {
      const doel = gebeurtenis.target;
      if (doel instanceof HTMLInputElement || doel instanceof HTMLSelectElement || doel instanceof HTMLTextAreaElement) {
        toonFout(doel);
      }
    }, true);
  }
</script>
