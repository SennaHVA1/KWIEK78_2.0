---
/**
 * Een wedstrijd als rij.
 *
 * De twee ploegen staan onder elkaar, met het wapen ervoor en de score
 * erachter. Zo lees je in een oogopslag wie er speelt en hoe het is
 * afgelopen. Naast elkaar met een streepje ertussen paste op een telefoon
 * niet en dwong tot afkappen van clubnamen.
 *
 * Bewust maar een label per rij, en alleen als het iets toevoegt: bij een
 * gewone competitiewedstrijd staat er niets, want dat is de standaard.
 * Waar je speelt staat als gewone tekst en niet als blokje.
 */
import Clubwapen from './Clubwapen.astro';
import { tijd, korteDatum, langeDatum } from '../lib/datum';
import { CLUB } from '../lib/sportlink';
import type { Wedstrijd } from '../lib/types';

interface Props {
  wedstrijd: Wedstrijd;
  /** Datum tonen in de rij zelf, voor lijsten die niet per dag gegroepeerd zijn. */
  toonDatum?: boolean;
  /** Accommodatie tonen. Uit op de teampagina, waar dat vaak hetzelfde is. */
  toonLocatie?: boolean;
}

const { wedstrijd, toonDatum = false, toonLocatie = true } = Astro.props;

const uitslag = wedstrijd.uitslag;
const gespeeld = uitslag !== undefined;
const isThuis = wedstrijd.thuisteam.startsWith(CLUB);
const eigenTeam = isThuis ? wedstrijd.thuisteam : wedstrijd.uitteam;

/* Alleen benoemen wat afwijkt. "Competitie" op elke rij is ruis. */
const bijzonder: Partial<Record<Wedstrijd['competitie'], string>> = {
  beker: 'Beker',
  oefen: 'Oefenwedstrijd',
  zaal: 'Zaalvoetbal',
};
const soort = bijzonder[wedstrijd.competitie];

const ploegen = [
  { naam: wedstrijd.thuisteam, logo: wedstrijd.thuisLogo, doelpunten: uitslag?.thuis },
  { naam: wedstrijd.uitteam, logo: wedstrijd.uitLogo, doelpunten: uitslag?.uit },
];

/* Waarop je deze rij kunt vinden met het zoekveld boven de lijst. Beide
   clubnamen, de accommodatie en de datum: zoek je op "beemster" dan wil je de
   wedstrijd tegen Beemster zien, ook als je zelf uit speelt. */
const zoektekst = [
  wedstrijd.thuisteam,
  wedstrijd.uitteam,
  wedstrijd.accommodatie,
  wedstrijd.veld ?? '',
  wedstrijd.competitie,
  korteDatum(wedstrijd.datum),
  langeDatum(wedstrijd.datum),
  isThuis ? 'thuis' : 'uit',
].join(' ');

const omschrijving = [
  wedstrijd.afgelast ? 'Afgelast: ' : '',
  `${wedstrijd.thuisteam} tegen ${wedstrijd.uitteam}`,
  gespeeld ? `, uitslag ${uitslag!.thuis} - ${uitslag!.uit}` : '',
  toonDatum ? `, ${korteDatum(wedstrijd.datum)}` : '',
  ` ${tijd(wedstrijd.datum)}`,
].join('');
---

<a
  class:list={['rij', 'wedstrijdrij', wedstrijd.afgelast && 'is-afgelast']}
  href={`/wedstrijd/${wedstrijd.wedstrijdcode}`}
  aria-label={omschrijving}
  data-filterbaar
  data-zoek={zoektekst}
  data-team={eigenTeam}
  data-locatie={isThuis ? 'thuis' : 'uit'}
  data-soort={wedstrijd.competitie}
>
  <div class="wr-tijd">
    {toonDatum && <span class="wr-dag">{korteDatum(wedstrijd.datum)}</span>}
    <span class="wr-uur data">{tijd(wedstrijd.datum)}</span>
  </div>

  <div class="wr-duel" aria-hidden="true">
    {ploegen.map((ploeg) => (
      <div class:list={['wr-ploeg', ploeg.naam === eigenTeam && 'is-eigen', wedstrijd.afgelast && 'doorgehaald']}>
        <Clubwapen src={ploeg.logo} club={ploeg.naam} formaat={28} />
        <span class="wr-naam">{ploeg.naam}</span>
        {gespeeld && <span class="wr-goals data">{ploeg.doelpunten}</span>}
      </div>
    ))}
  </div>

  <div class="wr-staart">
    {wedstrijd.afgelast && <span class="merk merk--afgelast">Afgelast</span>}
    {!wedstrijd.afgelast && soort && <span class="merk merk--zacht">{soort}</span>}
    {toonLocatie && (
      <span class="wr-plek">
        {isThuis ? 'Thuis' : 'Uit'}, {wedstrijd.accommodatie}{wedstrijd.veld ? `, ${wedstrijd.veld}` : ''}
      </span>
    )}
  </div>
</a>

<style>
  .wedstrijdrij {
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      "tijd duel"
      "tijd staart";
    column-gap: 1rem;
    row-gap: 0.4rem;
    text-decoration: none;
    color: inherit;
    align-items: start;
    transition: background-color 0.16s var(--ease-klap);
  }
  .wedstrijdrij:hover { background: var(--kleur-papier-op); }
  :global(.vlak-zwart) .wedstrijdrij:hover,
  :global(.vlak-inkt) .wedstrijdrij:hover { background: var(--kleur-inkt-op); }
  @media (prefers-reduced-motion: reduce) { .wedstrijdrij { transition: none; } }

  /* Tijd ------------------------------------------------------------- */
  .wr-tijd {
    grid-area: tijd;
    display: grid;
    justify-items: start;
    min-width: 3.5rem;
    padding-top: 0.15rem;
  }
  .wr-dag {
    font-family: var(--font-smal);
    font-size: var(--text-mini);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-grijsdonker);
  }
  :global(.vlak-zwart) .wr-dag, :global(.vlak-inkt) .wr-dag { color: var(--color-grijs); }
  .wr-uur {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.1;
  }

  /* De twee ploegen onder elkaar ------------------------------------- */
  .wr-duel { grid-area: duel; display: grid; gap: 0.3rem; min-width: 0; }

  .wr-ploeg {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }
  .wr-naam {
    font-size: var(--text-basis);
    font-weight: 500;
    line-height: 1.25;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* De eigen ploeg zwaarder: dan zie je meteen of je thuis of uit speelt. */
  .wr-ploeg.is-eigen .wr-naam { font-weight: 700; }

  .wr-goals {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1;
    min-width: 1.1rem;
    text-align: right;
    color: var(--color-blauwdiep);
  }
  :global(.vlak-zwart) .wr-goals, :global(.vlak-inkt) .wr-goals { color: var(--color-blauw); }

  /* Staart ------------------------------------------------------------ */
  .wr-staart {
    grid-area: staart;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .wr-plek {
    font-size: var(--text-klein);
    color: var(--color-grijsdonker);
    line-height: 1.35;
  }
  :global(.vlak-zwart) .wr-plek, :global(.vlak-inkt) .wr-plek { color: var(--color-grijs); }

  @media (min-width: 768px) {
    .wedstrijdrij {
      grid-template-columns: 5rem minmax(0, 1.4fr) minmax(0, 1fr);
      grid-template-areas: "tijd duel staart";
      column-gap: 1.5rem;
      align-items: center;
    }
    .wr-tijd { align-self: center; padding-top: 0; }
    .wr-uur { font-size: 1.5rem; }
    .wr-staart { justify-content: flex-end; text-align: right; }
    .wr-plek { text-align: right; }
  }
</style>
