---
/**
 * Informatiebulletin.
 *
 * Op de oude site was dit een pagina met een knop naar een PDF. Het bulletin
 * staat nu gewoon op de pagina: de kantineregels, de contributiebedragen en
 * de opzegtermijn zijn precies het soort dingen die je op een telefoon langs
 * het veld wilt kunnen opzoeken, en dat lukt niet in een download. Er staan
 * daarom ook geen documenten meer op deze pagina: alles wat erin stond, staat
 * er nu zelf.
 *
 * De tekst is die van de club. Alleen de aanspreekvorm is meegegaan met de
 * rest van de site (je in plaats van u); aan de afspraken zelf, de bedragen
 * en de termijnen is niets veranderd.
 *
 * De vorm is een raster met haarlijnen in plaats van losse kaartjes. Elk vak
 * heeft evenveel ruimte en de lijnen lopen door van boven naar onder, zodat
 * de pagina leest als een blad met vakken en niet als een verzameling
 * zwevende blokjes. Vier vakken staan twee bij twee, zes vakken drie bij
 * twee: altijd volle rijen, nooit een enkel vak dat achterblijft.
 */
import Basis from '../../layouts/Basis.astro';
import Paginakop from '../../components/Paginakop.astro';
import Accordeon from '../../components/Accordeon.astro';
import { getContributie, CLUBGEGEVENS, routeLink } from '../../lib/club';

const contributie = getContributie();

/** De snelkoppelingen in de zwarte kop. */
const inhoud = [
  { href: '#accommodatie', label: 'Accommodatie' },
  { href: '#huisregels', label: 'Huisregels' },
  { href: '#voetballen', label: 'Trainen en spelen' },
  { href: '#contributie', label: 'Contributie' },
  { href: '#lidmaatschap', label: 'Lidmaatschap' },
  { href: '#meedoen', label: 'Meedoen' },
  { href: '#kunstgras', label: 'Kunstgras' },
];

/* Afspraken op het complex. De vololgorde is op lengte gezet: het langste
   vak naast het langste, zodat beide rijen even hoog uitkomen. */
const huisregels = [
  {
    titel: 'Kantine',
    punten: [
      'Op zaterdag is de kantine open tot een uur na het einde van de laatste wedstrijd.',
      'Op zaterdag schenken we geen alcohol.',
      'Op andere dagen schenken we geen alcohol aan bezoekers onder de 18 jaar. Bij twijfel vraagt de kantinedienst om een legitimatiebewijs.',
      'Op zondag stopt de verkoop uiterlijk om 18:00 uur. Om 18:30 uur gaat de kantine dicht.',
    ],
  },
  {
    titel: 'Kleding',
    punten: [
      "Het tenue is een wit shirt met een zwarte broek en zwarte sokken. Voor alle teams zijn tenues beschikbaar.",
      "Sinds seizoen 2010/2011 loopt het kledingplan: leden betalen jaarlijks een bijdrage voor de aanschaf. De tenues blijven eigendom van Kwiek '78.",
      'Sponsors kunnen tegen een vaste vergoeding een reclame-uiting op de shirts laten aanbrengen. We zijn blij met al onze sponsors en bevelen ze van harte bij je aan.',
      'Een tenue blijft vier jaar bij hetzelfde team. De O13-1 houdt dus het tenue van de O13-1: het gaat niet mee met spelers naar een ander team, ook niet als een familielid sponsor van dat team is.',
      'De tenues worden bij toerbeurt gewassen; de begeleider stelt daarvoor een wasschema op. Scheenbeschermers, voetbalschoenen en trainingskleding neem je zelf mee.',
    ],
  },
  {
    titel: 'Kleedkamers',
    punten: [
      'De kleedkamer wordt na gebruik schoongemaakt met een bezem en een vloerwisser. De aanvoerder en de begeleider van het team houden daar toezicht op.',
      'Voetbalschoenen sla je niet uit tegen de wanden van de kleedkamer, maar maak je buiten schoon aan de borstels.',
    ],
  },
  {
    titel: 'Rookvrij',
    punten: [
      'De kantine is in zijn geheel rookvrij.',
      'Op de trainingsuren van de jeugd en op zaterdag is het hele terrein rookvrij. Roken kan dan alleen buiten het hek.',
    ],
  },
];

/* Afspraken rond trainingen en wedstrijden. */
const voetbalregels = [
  {
    titel: 'Trainingen',
    punten: [
      'Het actuele trainingsschema staat op de website.',
      'De velden zitten vol, dus de trainers beginnen op tijd. Sta tien minuten voor aanvang omgekleed naast het veld.',
      'Het trainingsveld betreed je pas als de groep voor je klaar is en de trainer daar toestemming voor geeft.',
      'Na afloop ruimt iedereen samen de materialen op. Pas als alles terug is, gaat de groep naar huis.',
      'Kun je niet trainen? Meld dat minimaal een half uur voor aanvang telefonisch bij je trainer.',
    ],
  },
  {
    titel: 'Afkeuringen',
    punten: [
      'We spelen in district West I. Een landelijke afkeuring staat in de Voetbal.nl-app en op NOS Teletekst pagina 603. Algehele afkeuringen staan ook op pagina 601.',
      'Is er geen landelijke afkeuring, dan informeert de begeleider het team, via het belsysteem of de appgroep.',
      'Krijgen we het op tijd door, dan zetten we het ook bij het wedstrijdprogramma op de website.',
      "De velden van Kwiek '78 worden gekeurd door een consul die daarvoor door de KNVB is aangewezen.",
    ],
  },
  {
    titel: 'Wedstrijden',
    punten: [
      'Bij thuiswedstrijden ben je minimaal een half uur voor aanvang aanwezig, tenzij de begeleider iets anders afspreekt.',
      'Bij uitwedstrijden van de jeugd rijden de ouders. Op de website staat wie er aan de beurt is.',
      'Kun je niet rijden? Zorg zelf voor vervanging en meld dat op tijd bij de begeleider van het team.',
    ],
  },
  {
    titel: 'Digitale spelerspas',
    punten: [
      'Vanaf O12 is een digitale spelerspas bij de wedstrijd verplicht. Dat is een eis van de KNVB.',
      'Bij de aanmelding lever je daarvoor een kleurenpasfoto in.',
      'Zonder digitale spelerspas mag er niet worden gevoetbald.',
    ],
  },
];

/* Het lidmaatschap in het kort, naast de lopende tekst. */
const lidmaatschapFeiten = [
  { term: 'Looptijd', uitleg: 'Minimaal een heel seizoen' },
  { term: 'Aanmelden', uitleg: 'Met het formulier op deze site' },
  { term: 'Opzeggen', uitleg: 'Schriftelijk, voor 1 juni' },
  { term: 'Bij wie', uitleg: 'De ledenadministratie' },
];

/* Waar je terechtkunt en hoe je meedoet. Zes vakken, drie bij twee. */
const meedoen = [
  {
    titel: 'Vrijwilligersdiensten',
    tekst: "Naast de leden die vrijwillig van alles regelen, is er een periodiek verplichte ondersteuning in de kantine: bardiensten, keukendiensten en schoonmaakdiensten op maandagochtend of maandagavond. Het rooster wordt jaarlijks opgesteld door de kantinecommissie en geldt voor alle senioren, O18- en MO20-junioren en de ouders van de overige jeugdleden. Kom je niet opdagen, dan brengen we 50 euro boete in rekening.",
    link: { href: '/vrijwillige-diensten', label: 'Het dienstenrooster' },
  },
  {
    titel: "Club van '78",
    tekst: "De Club van '78 is een onafhankelijke club binnen de vereniging, opgericht om Kwiek '78 jaarlijks te steunen met een bijdrage aan doelen die de leden zelf kiezen. De leden zijn vrienden van de vereniging en organiseren samen leuke evenementen.",
    link: { href: '/sponsoring#club-van-78', label: "Aanmelden bij de Club van '78" },
  },
  {
    titel: 'Loterij en entree',
    tekst: 'Op de zondagen dat het eerste elftal thuis speelt, vragen we entree. Daarvoor krijg je lootjes voor de loterij, die in de rust wordt getrokken. De opbrengst betaalt de activiteiten van de jeugdelftallen, zoals de jeugdslotdag. De O15-junioren verkopen de lootjes, met ondersteuning van iemand van het bestuur.',
  },
  {
    titel: 'Bestuur',
    tekst: 'Iedere donderdagavond vanaf 20:00 uur is er een bestuurslid aanwezig op het complex. Heb je vragen of opmerkingen, dan kun je die op dat moment kwijt.',
    link: { href: '/club/bestuur', label: 'Bestuur en commissies' },
  },
  {
    titel: 'Sponsoring',
    tekst: "Ook jij kunt sponsor worden. Kwiek '78 voert een actief PR-beleid en onze PR-leden informeren je graag over de mogelijkheden.",
    link: { href: 'mailto:sponsoring@kwiek78.nl', label: 'sponsoring@kwiek78.nl' },
  },
  {
    titel: 'Nieuws op de site',
    tekst: 'Op deze site staat alle informatie over de vereniging, ook over afgelastingen. Het wedstrijdprogramma is er altijd het meest actueel. Heb je nieuws of wil je een artikel laten plaatsen?',
    link: { href: 'mailto:post@kwiek78.nl', label: 'post@kwiek78.nl' },
  },
];

const kunstgrasregels = [
  {
    vraag: 'Welk schoeisel is toegestaan?',
    antwoord: 'Kunstgrasnoppen of multinoppen. IJzeren studs mogen niet: die trekken de vezels los en beschadigen de mat blijvend. Zaalschoenen mogen bij techniektrainingen, maar geven bij nat weer te weinig grip.',
  },
  {
    vraag: 'Waarom mag er niet gegeten of gedronken worden op het veld?',
    antwoord: 'Suikerresten trekken vuil aan en tasten de infill aan. Bidons zijn geen probleem, mits ze water bevatten. Sportdrank en kauwgom horen aan de kant, niet op de mat.',
  },
  {
    vraag: 'Mogen doelen verplaatst worden?',
    antwoord: 'Alleen tillend en met minimaal vier personen. Slepen laat sporen achter die er niet meer uit gaan. De kleine doelen hebben wieltjes, daar mag je wel mee rijden.',
  },
  {
    vraag: 'Wat te doen bij vorst of sneeuw?',
    antwoord: 'Bij bevroren mat wordt er niet gespeeld en niet getraind: bevroren vezels breken af. Sneeuw wordt niet weggeschoven maar laten liggen tot hij smelt. De consul bepaalt of het veld open gaat.',
  },
  {
    vraag: 'Wie ruimt op na de training?',
    antwoord: 'Het team dat als laatste op het veld staat. Doelen terug op de plek, pionnen en hesjes mee naar het materiaalhok, en de laatste kijkt of er niets is blijven liggen.',
  },
];

/** Nummer van een vak, altijd twee cijfers: 01, 02, 03. */
const nummer = (i: number) => String(i + 1).padStart(2, '0');

const telefoonSchoon = CLUBGEGEVENS.telefoon.replace(/\s/g, '');
---

<Basis
  titel="Informatiebulletin"
  omschrijving="Het informatiebulletin van v.v. Kwiek '78: huisregels, kleding, trainingen, contributie, lidmaatschap en de richtlijnen voor het kunstgras."
>
  <Paginakop
    kicker="Club"
    titel="Informatiebulletin"
    intro="De afspraken die we bij Kwiek '78 met elkaar hebben gemaakt, van de kantine tot de contributie. Geen PDF: gewoon leesbaar op de pagina."
  >
    <nav class="inhoud" aria-label="Op deze pagina">
      <ul class="inhoud-lijst">
        {inhoud.map((item) => (
          <li><a class="inhoud-link" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </Paginakop>

  <!-- ================================================================== -->
  <!-- Welkom en accommodatie                                             -->
  <!-- ================================================================== -->
  <section class="vlak-wit sectie" id="accommodatie">
    <div class="omhulsel">
      <div class="kolom">
        <p class="kolom-kicker">Welkom</p>
        <div class="welkom">
          <div>
            <h2 class="kop-sectie welkom-kop">Het sportieve hart van Avenhorn</h2>
            <div class="lopende-tekst">
              <p>
                Bij Kwiek '78 voetballen is leuk voor jong en oud. Het is een vereniging waar
                sportiviteit en gezelligheid hoog in het vaandel staan. Met trots noemen we ons
                het sportieve hart van Avenhorn, en dat willen we ook in de toekomst blijven
                uitstralen.
              </p>
              <p>
                Van onze leden verwachten we een positieve instelling, in en buiten het veld.
                Verbaal en fysiek geweld tolereren we niet. We behandelen onze tegenstanders met
                respect, net zoals we zelf met respect behandeld willen worden.
              </p>
              <p>
                We werken met veel vrijwilligers die bereid zijn vele uurtjes in de club te
                steken. Spreek je waardering daar eens naar uit en geef ze de kans om het je naar
                de zin te maken. Je bent ook van harte welkom om zelf deel uit te maken van deze
                groep enthousiastelingen.
              </p>
              <p>
                Hieronder staat de belangrijkste informatie en staan de regels die we met elkaar
                hebben afgesproken.
              </p>
            </div>
          </div>

          <aside class="adres">
            <p class="adres-kicker">Accommodatie</p>
            <p class="adres-naam">{CLUBGEGEVENS.sportpark}</p>
            <address class="adres-regels">
              {CLUBGEGEVENS.straat}<br />
              {CLUBGEGEVENS.postcode} {CLUBGEGEVENS.plaats}
            </address>
            <p class="adres-telefoon">
              <a class="link-onder data" href={`tel:${telefoonSchoon}`}>{CLUBGEGEVENS.telefoon}</a>
            </p>
            <a class="knop knop--rand adres-knop" href={routeLink()} target="_blank" rel="noopener noreferrer">
              Route naar het sportpark
            </a>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Huisregels                                                         -->
  <!-- ================================================================== -->
  <section class="vlak-papier sectie" id="huisregels">
    <div class="omhulsel">
      <div class="kolom">
        <p class="kolom-kicker">Op het complex</p>
        <h2 class="kop-sectie blokkop">Huisregels</h2>
        <div class="raster raster--twee raster--papier">
          {huisregels.map((blok, i) => (
            <article class="vak">
              <p class="vak-nummer data" aria-hidden="true">{nummer(i)}</p>
              <h3 class="vak-titel">{blok.titel}</h3>
              <ul class="vak-punten">
                {blok.punten.map((punt) => <li>{punt}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Trainen en spelen                                                  -->
  <!-- ================================================================== -->
  <section class="vlak-wit sectie" id="voetballen">
    <div class="omhulsel">
      <div class="kolom">
        <p class="kolom-kicker">Op het veld</p>
        <h2 class="kop-sectie blokkop">Trainen en spelen</h2>
        <div class="raster raster--twee raster--wit">
          {voetbalregels.map((blok, i) => (
            <article class="vak">
              <p class="vak-nummer data" aria-hidden="true">{nummer(i)}</p>
              <h3 class="vak-titel">{blok.titel}</h3>
              <ul class="vak-punten">
                {blok.punten.map((punt) => <li>{punt}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="baan" aria-hidden="true"></div>

  <!-- ================================================================== -->
  <!-- Contributie                                                        -->
  <!-- ================================================================== -->
  <section class="vlak-zwart sectie" id="contributie">
    <div class="omhulsel">
      <div class="kolom">
        <p class="kolom-kicker">Seizoen {contributie.seizoen}</p>
        <div class="contributie">
          <h2 class="kop-sectie">Contributie</h2>

          {/* De zaalreeks telt vier categorieen en de veldreeks acht. Het
              kledingplan en de uitleg over de incasso staan daarom onder de
              zaaltabel: dan eindigen beide kolommen op dezelfde hoogte. */}
          <div class="raster raster--twee raster--donker">
            {contributie.reeksen.map((reeks) => (
              <div class="vak">
                <table class="tarief">
                  <caption class="tarief-kop">{reeks.label}</caption>
                  <tbody>
                    {reeks.tarieven.map((tarief) => (
                      <tr>
                        <th scope="row">{tarief.categorie}</th>
                        <td class="tarief-bedrag data">&euro;&nbsp;{tarief.bedrag},-</td>
                      </tr>
                    ))}
                  </tbody>
                </table>

                {reeks.soort === 'zaal' && (
                  <div class="naschrift">
                    <p class="kleding">
                      <span class="kleding-bedrag data">&euro;&nbsp;{contributie.kledingplan},-</span>
                      <span class="kleding-uitleg">Kledingplan per spelend lid, bovenop het basisbedrag</span>
                    </p>
                    <p class="contributie-uitleg">
                      De contributie wordt geincasseerd via onze contributiepartner NIKKI. Je
                      krijgt van ze een mail met het betaalverzoek en betaalt daarna in een keer,
                      of in delen. Bij in delen betalen komen er administratiekosten bij, die naar
                      NIKKI gaan.
                    </p>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="baan" aria-hidden="true"></div>

  <!-- ================================================================== -->
  <!-- Lidmaatschap                                                       -->
  <!-- ================================================================== -->
  <section class="vlak-wit sectie" id="lidmaatschap">
    <div class="omhulsel">
      <div class="kolom">
        <p class="kolom-kicker">Aanmelden en opzeggen</p>
        <div class="lidmaatschap">
          <div>
            <h2 class="kop-sectie welkom-kop">Lidmaatschap</h2>
            <div class="lopende-tekst">
              <p>
                Het lidmaatschap loopt minimaal een seizoen. Lid worden kan met het formulier op
                deze site: je vult het in en de ledenadministratie neemt contact met je op.
              </p>
              <p>
                Opzeggen kan uitsluitend schriftelijk bij de ledenadministratie, en moet
                <strong>voor 1 juni</strong> van het lopende seizoen gebeuren. Zeg je later op, dan
                wordt de contributie voor het volgende seizoen nog in rekening gebracht. Je
                gegevens wijzigen kan met hetzelfde formulier.
              </p>
            </div>
            <div class="lidmaatschap-knoppen">
              <a class="knop knop--primair" href="/club/lid-worden">Lid worden</a>
              <a class="knop knop--rand" href="/club/lid-worden">Lidmaatschap wijzigen</a>
            </div>
          </div>

          <dl class="feiten">
            {lidmaatschapFeiten.map((feit) => (
              <div class="feit">
                <dt>{feit.term}</dt>
                <dd>{feit.uitleg}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Meedoen                                                            -->
  <!-- ================================================================== -->
  <section class="vlak-papier sectie" id="meedoen">
    <div class="omhulsel">
      <div class="kolom">
        <p class="kolom-kicker">De club draait op mensen</p>
        <h2 class="kop-sectie blokkop">Meedoen en contact</h2>
        <div class="raster raster--drie raster--papier">
          {meedoen.map((blok, i) => (
            <article class="vak">
              <p class="vak-nummer data" aria-hidden="true">{nummer(i)}</p>
              <h3 class="vak-titel">{blok.titel}</h3>
              <p class="vak-tekst">{blok.tekst}</p>
              {blok.link && (
                <a class="vak-link link-onder" href={blok.link.href}>{blok.link.label}</a>
              )}
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="baan" aria-hidden="true"></div>

  <!-- ================================================================== -->
  <!-- Richtlijnen kunstgras                                              -->
  <!-- ================================================================== -->
  <section class="vlak-zwart sectie" id="kunstgras">
    <div class="omhulsel">
      <div class="kolom">
        <p class="kolom-kicker">Kunstgras</p>
        <div class="kunstgras">
          <div class="kunstgras-tekst">
            <h2 class="kop-sectie">Richtlijnen gebruik kunstgras</h2>
            <p class="kunstgras-intro">
              Het kunstgrasveld ligt er sinds 2021 en moet nog zeker tien jaar mee.
              Dat lukt alleen als iedereen zich aan een paar afspraken houdt.
              Trainers en leiders worden geacht deze regels te kennen.
            </p>
          </div>

          <div class="kunstgras-regels">
            <Accordeon items={kunstgrasregels} label="Veelgestelde vragen over het kunstgras" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Basis>

<style>
  /* De sticky kopbalk is 72 pixels hoog. Zonder deze marge verdwijnt de kop
     van een sectie eronder zodra je op een snelkoppeling klikt. */
  section[id] { scroll-margin-top: 5.5rem; }

  .blokkop { padding-bottom: 1.5rem; }

  /* Snelkoppelingen in de zwarte kop ---------------------------------- */
  .inhoud { margin-top: 1.6rem; }
  .inhoud-lijst {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .inhoud-link {
    display: inline-block;
    border: 1px solid var(--kleur-lijn-donker);
    border-radius: var(--radius-vlak);
    padding: 0.4rem 0.75rem;
    font-family: var(--font-smal);
    font-size: var(--text-mini);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-wit);
    transition: border-color 0.15s var(--ease-klap), background-color 0.15s var(--ease-klap);
  }
  .inhoud-link:hover { border-color: var(--color-wit); background: var(--kleur-inkt-op); }
  @media (prefers-reduced-motion: reduce) { .inhoud-link { transition: none; } }

  /* ------------------------------------------------------------------ */
  /* Het raster                                                         */
  /* ------------------------------------------------------------------ */
  /* Een omlijnd vlak dat door haarlijnen in gelijke vakken is verdeeld.
     De lijnen zijn de rasterafstand zelf: de vakken staan een pixel uit
     elkaar en de rand eronder schijnt erdoorheen. Daardoor lopen ze altijd
     precies door en zijn alle vakken even breed en even hoog.           */
  .raster {
    display: grid;
    gap: 1px;
    grid-template-columns: 1fr;
    border: 1px solid;
    border-radius: var(--radius-vlak);
    overflow: hidden;
  }
  .raster--papier { background: var(--kleur-lijn-licht); border-color: var(--kleur-lijn-licht); }
  .raster--wit    { background: var(--kleur-lijn-licht); border-color: var(--kleur-lijn-licht); }
  .raster--donker { background: var(--kleur-lijn-donker); border-color: var(--kleur-lijn-donker); }

  @media (min-width: 720px) {
    .raster--twee { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .raster--drie { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1040px) {
    .raster--drie { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .vak {
    display: flex;
    flex-direction: column;
    padding: clamp(1.35rem, 1rem + 1vw, 2rem);
  }
