---
/**
 * Een nieuwsbericht in een lijst.
 *
 * Een omkaderd blok: haarlijn eromheen, de foto strak tegen de bovenrand en
 * de tekst met wat lucht eromheen. De rand houdt de berichten bij elkaar in
 * een raster waarin de kaarten verschillend hoog zijn; zonder rand liepen de
 * koppen en samenvattingen visueel in elkaar over.
 *
 * De kaart is meer dan een lijntje: linksboven zit een kort zwart streepje dat
 * bij het aanwijzen over de hele breedte uitloopt en blauw wordt. Dat streepje
 * is dezelfde zware zwarte regel die op deze site boven een tabel en onder een
 * commissiekop staat; hier is het het merkteken van de kaart. Vier kaarten
 * naast elkaar lijnen daardoor langs een zichtbare bovenrand uit in plaats van
 * te zweven in een raster.
 */
import Foto from './Foto.astro';
import { datumZonderDag, machineDatum } from '../lib/datum';
import type { Artikel } from '../lib/types';

interface Props {
  artikel: Artikel;
  /** Grote variant, voor het eerste bericht in een overzicht. */
  groot?: boolean;
  /**
   * Kopniveau van de titel. Staat de lijst los op een pagina, dan is 2 goed;
   * hangt hij onder een sectiekop, geef dan 3 mee.
   */
  kopNiveau?: 2 | 3;
  /**
   * Onder 640px inklappen tot een regel met een klein vierkant beeld ernaast,
   * zonder samenvatting. Voor de homepage: daar is nieuws bijvangst en niet
   * waarvoor iemand op zaterdagochtend de site opent.
   */
  compactOpMobiel?: boolean;
}

const { artikel, groot = false, kopNiveau = 3, compactOpMobiel = false } = Astro.props;
const Kop = `h${kopNiveau}` as 'h2' | 'h3';
---

<article class:list={['nieuwskaart', groot && 'nieuwskaart--groot', compactOpMobiel && 'nieuwskaart--compact']}>
  <a class="nieuwskaart-link" href={`/nieuws/${artikel.slug}`}>
    <div class="nieuwskaart-beeld">
      <Foto
        src={artikel.afbeelding}
        alt={`Foto bij het bericht: ${artikel.titel}`}
        ratio={groot ? '16 / 9' : '4 / 3'}
        plaatshouder="foto volgt"
      />
    </div>

    <div class="nieuwskaart-tekst">
      <p class="nieuwskaart-meta data">
        <time datetime={machineDatum(artikel.datum)}>{datumZonderDag(artikel.datum)}</time>
        {artikel.bron === 'facebook' && <span class="nieuwskaart-bron">via Facebook</span>}
      </p>
      <Kop class:list={[groot ? 'kop-m' : 'kop-s']}>{artikel.titel}</Kop>
      <p class="nieuwskaart-samenvatting">{artikel.samenvatting}</p>
      <span class="nieuwskaart-lees data">Lees verder</span>
    </div>
  </a>
</article>

<style>
  /* De kaart -------------------------------------------------------------- */
  .nieuwskaart {
    position: relative;
    height: 100%;
    /* Twee kleuren in de rand: de bovenkant iets donkerder dan de rest, zodat
       de kaart bovenaan afsluit en niet als los vierkantje in de lucht hangt. */
    --rand: var(--kleur-lijn-licht);
    --rand-op: color-mix(in srgb, var(--color-zwart) 28%, transparent);
    --streep: var(--color-zwart);
    --streep-op: var(--color-blauwdiep);
    border: 1px solid var(--rand);
    border-radius: var(--radius-vlak);
    background: var(--color-wit);
    overflow: hidden;
    transition:
      border-color 0.18s var(--ease-klap),
      box-shadow 0.2s var(--ease-klap),
      transform 0.2s var(--ease-klap);
  }
  :global(.vlak-zwart) .nieuwskaart, :global(.vlak-inkt) .nieuwskaart {
    --rand: var(--kleur-lijn-donker);
    --rand-op: color-mix(in srgb, var(--color-wit) 34%, transparent);
    --streep: var(--color-wit);
    --streep-op: var(--color-blauw);
    background: var(--kleur-inkt);
  }

  /* Het streepje. Ligt over de foto heen, dus het heeft een eigen laag nodig. */
  .nieuwskaart::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    height: 3px;
    width: 4.5rem;
    max-width: 45%;
    background: var(--streep);
    transition: width 0.3s var(--ease-klap), background-color 0.18s var(--ease-klap);
  }

  .nieuwskaart:hover {
    border-color: var(--rand-op);
    transform: translateY(-2px);
    box-shadow: 0 10px 26px color-mix(in srgb, var(--color-zwart) 9%, transparent);
  }
  :global(.vlak-zwart) .nieuwskaart:hover, :global(.vlak-inkt) .nieuwskaart:hover {
    box-shadow: none;
  }
  .nieuwskaart:hover::before, .nieuwskaart:focus-within::before {
    width: 100%;
    max-width: 100%;
    background: var(--streep-op);
  }

  @media (prefers-reduced-motion: reduce) {
    .nieuwskaart, .nieuwskaart::before { transition: none; }
    .nieuwskaart:hover { transform: none; }
  }

  .nieuwskaart-link {
    display: grid;
    gap: 0;
    text-decoration: none;
    color: inherit;
    height: 100%;
    align-content: start;
  }

  /* Beeld ---------------------------------------------------------------- */
  /* De foto loopt tot tegen de rand van de kaart, dus geen eigen ronding.
     Foto.astro zet die als inline stijl, vandaar het !important. */
  .nieuwskaart-beeld { overflow: hidden; }
  .nieuwskaart-beeld :global(img) {
    border-radius: 0 !important;
    transition: transform 0.5s var(--ease-klap);
  }
  .nieuwskaart-beeld :global(.foto-plek) { border-radius: 0; }
  .nieuwskaart-link:hover .nieuwskaart-beeld :global(img) { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    .nieuwskaart-beeld :global(img) { transition: none; }
    .nieuwskaart-link:hover .nieuwskaart-beeld :global(img) { transform: none; }
  }

  /* Tekst ----------------------------------------------------------------- */
  .nieuwskaart-tekst {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1rem 1.15rem 1.2rem;
  }

  .nieuwskaart-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-smal);
    font-size: var(--text-mini);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-grijs);
  }
  :global(.vlak-wit) .nieuwskaart-meta { color: var(--color-grijsdonker); }
  .nieuwskaart-bron { color: var(--color-blauw); }
  :global(.vlak-wit) .nieuwskaart-bron { color: var(--color-blauwdiep); }

  .nieuwskaart-samenvatting {
    font-size: var(--text-klein);
    line-height: 1.6;
    color: var(--color-grijs);
    max-width: 52ch;
  }
  :global(.vlak-wit) .nieuwskaart-samenvatting { color: var(--color-grijsdonker); }

  .nieuwskaart-lees {
    font-size: var(--text-klein);
    font-weight: 600;
    color: var(--color-blauw);
    margin-top: 0.15rem;
  }
  :global(.vlak-wit) .nieuwskaart-lees { color: var(--color-blauwdiep); }
  .nieuwskaart-link:hover .nieuwskaart-lees { text-decoration: underline; text-underline-offset: 0.25em; }

  /* Grote variant: beeld links, tegen de rand aan, over de hele hoogte. ---- */
  @media (min-width: 720px) {
    .nieuwskaart--groot .nieuwskaart-link {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: stretch;
    }
    .nieuwskaart--groot .nieuwskaart-beeld :global(img),
    .nieuwskaart--groot .nieuwskaart-beeld :global(.foto-plek) {
      height: 100%;
      min-height: 19rem;
      aspect-ratio: auto !important;
      object-fit: cover;
    }
    .nieuwskaart--groot .nieuwskaart-tekst {
      align-content: center;
      padding: 2rem 2.25rem;
    }
  }

  /* Compacte variant, alleen op een telefoon. Beeld naar een klein vierkant
     naast de tekst, samenvatting en "Lees verder" eruit. Vier berichten passen
     dan in de hoogte van een enkele kaart van hiervoor. */
  @media (max-width: 639px) {
    .nieuwskaart--compact .nieuwskaart-link {
      grid-template-columns: 76px minmax(0, 1fr);
      gap: 0.85rem;
      align-items: center;
      padding: 0.6rem;
    }
    .nieuwskaart--compact .nieuwskaart-beeld { border-radius: var(--radius-klein); }
    .nieuwskaart--compact .nieuwskaart-beeld :global(img) { border-radius: var(--radius-klein) !important; }
    .nieuwskaart--compact .nieuwskaart-beeld :global(img),
    .nieuwskaart--compact .nieuwskaart-beeld :global(.foto-plek) {
      aspect-ratio: 1 / 1 !important;
    }
    .nieuwskaart--compact .nieuwskaart-tekst { gap: 0.2rem; padding: 0; }
    .nieuwskaart--compact .nieuwskaart-tekst :is(h2, h3) {
      font-size: 1.0625rem;
      line-height: 1.25;
    }
    .nieuwskaart--compact .nieuwskaart-samenvatting,
    .nieuwskaart--compact .nieuwskaart-lees { display: none; }
  }
</style>
