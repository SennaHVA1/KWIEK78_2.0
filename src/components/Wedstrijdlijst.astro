---
/**
 * Een lijst wedstrijden, gegroepeerd per speeldag.
 *
 * De speeldag staat als balk boven de groep in plaats van als kickertje in
 * de kantlijn. Een parkeerplaats vol ouders scant op de dag, niet op een
 * subtiel label.
 */
import Wedstrijddag from './Wedstrijddag.astro';
import { groepeerPerDag } from '../lib/datum';
import type { Wedstrijd } from '../lib/types';

interface Props {
  wedstrijden: Wedstrijd[];
  toonLocatie?: boolean;
  leegTekst?: string;
  /**
   * Kopniveau van de speeldag. Staat de lijst los op een pagina, dan is 2
   * goed; hangt hij onder een sectiekop, geef dan 3 mee.
   */
  kopNiveau?: 2 | 3;
  /**
   * Aantal speeldagen dat direct zichtbaar is. De rest zit achter een
   * uitklapknop, zodat een heel seizoensprogramma de pagina niet oprekt.
   */
  zichtbaar?: number;
}

const {
  wedstrijden,
  toonLocatie = true,
  leegTekst = 'Er staan op dit moment geen wedstrijden gepland.',
  kopNiveau = 2,
  zichtbaar,
} = Astro.props;

const dagen = groepeerPerDag(wedstrijden, (w) => w.datum);
const grens = zichtbaar !== undefined ? Math.min(zichtbaar, dagen.length) : dagen.length;
const direct = dagen.slice(0, grens);
const verborgen = dagen.slice(grens);
const aantalVerborgen = verborgen.reduce((som, dag) => som + dag.items.length, 0);
---

{dagen.length === 0 ? (
  <p class="lege-lijst zacht">{leegTekst}</p>
) : (
  <div class="wedstrijdlijst">
    {direct.map((dag) => (
      <Wedstrijddag label={dag.label} wedstrijden={dag.items} toonLocatie={toonLocatie} kopNiveau={kopNiveau} />
    ))}
    {verborgen.length > 0 && (
      <details class="meer">
        <summary class="knop knop--rand">
          <span class="meer-dicht">{`Toon nog ${aantalVerborgen} ${aantalVerborgen === 1 ? 'wedstrijd' : 'wedstrijden'}`}</span>
          <span class="meer-open">Toon minder</span>
        </summary>
        <div class="wedstrijdlijst meer-inhoud">
          {verborgen.map((dag) => (
            <Wedstrijddag label={dag.label} wedstrijden={dag.items} toonLocatie={toonLocatie} kopNiveau={kopNiveau} />
          ))}
        </div>
      </details>
    )}
  </div>
)}

<style>
  .wedstrijdlijst { display: grid; gap: 2rem; }

  .meer summary { width: fit-content; cursor: pointer; list-style: none; }
  .meer summary::-webkit-details-marker { display: none; }
  .meer-open { display: none; }
  .meer[open] .meer-dicht { display: none; }
  .meer[open] .meer-open { display: inline; }
  .meer-inhoud { margin-top: 2rem; }

  .lege-lijst {
    padding: 1.5rem;
    border-radius: var(--radius-vlak);
    background: var(--kleur-papier-diep);
    font-size: var(--text-klein);
  }
  :global(.vlak-zwart) .lege-lijst, :global(.vlak-inkt) .lege-lijst { background: var(--kleur-inkt-op); }
</style>
