---
/**
 * HET SCOREBORD
 *
 * De eerstvolgende wedstrijd, over de volle breedte, met beide clubwapens en
 * de afteller. Dit blok staat op de tweede plek van de homepage omdat het de
 * vraag beantwoordt waarvoor de meeste mensen hier komen: wanneer en waar.
 *
 * Bewust weinig velden. Eerder stonden hier vier losse gegevens in een
 * rasterlijst en dat las als een formulier; nu staat er een zin.
 *
 * Waarom er meerdere wedstrijden worden meegegeven: de site wordt statisch
 * gebouwd. Wordt hij een paar weken niet opnieuw gebouwd, dan zou de aftrap
 * in het verleden liggen. Daarom worden de eerstvolgende paar wedstrijden
 * alle gerenderd en toont een klein script de eerste die nog moet komen.
 */
import Klapbord from './Klapbord.astro';
import Clubwapen from './Clubwapen.astro';
import { langeDatum, tijd, machineDatum } from '../lib/datum';
import { routeLink } from '../lib/club';
import type { Wedstrijd } from '../lib/types';

interface Props {
  /** De eerstvolgende wedstrijden, chronologisch. De eerste is zichtbaar. */
  wedstrijden: Wedstrijd[];
}

const { wedstrijden } = Astro.props;

const soortLabel: Record<Wedstrijd['competitie'], string> = {
  competitie: 'Competitie',
  beker: 'Beker',
  oefen: 'Oefenwedstrijd',
  zaal: 'Zaalvoetbal',
};
---

<section class="scorebord vlak-zwart" aria-labelledby="eerstvolgende-kop" data-scorebord>
  <div class="omhulsel scorebord-binnen">
    <p class="kolom-kicker" id="eerstvolgende-kop">Eerstvolgende wedstrijd</p>

    {wedstrijden.length === 0 && (
      <p class="scorebord-leeg zacht">
        Er staat op dit moment geen wedstrijd gepland. Zodra het programma bekend is staat hij hier.
      </p>
    )}

    {wedstrijden.map((wedstrijd, index) => (
      <article class="scorebord-wedstrijd" data-wedstrijd data-aftrap={wedstrijd.datum} hidden={index > 0}>
        <div class="scorebord-links">
          <h2 class="scorebord-duel">
            <span class="scorebord-club">
              <Clubwapen src={wedstrijd.thuisLogo} club={wedstrijd.thuisteam} formaat={52} />
              <span>{wedstrijd.thuisteam}</span>
            </span>
            <span class="scorebord-tegen">tegen</span>
            <span class="scorebord-club">
              <Clubwapen src={wedstrijd.uitLogo} club={wedstrijd.uitteam} formaat={52} />
              <span>{wedstrijd.uitteam}</span>
            </span>
          </h2>

          <p class="scorebord-wanneer">
            <span class="merk merk--afgelast">{soortLabel[wedstrijd.competitie]}</span>
            <time datetime={machineDatum(wedstrijd.datum)}>
              {langeDatum(wedstrijd.datum)} om {tijd(wedstrijd.datum)}
            </time>
          </p>
          <p class="scorebord-waar zacht">
            {wedstrijd.accommodatie}{wedstrijd.veld ? `, ${wedstrijd.veld}` : ''}
          </p>

          <div class="scorebord-knoppen">
            <a class="knop knop--primair" href="/wedstrijden/programma">Heel het programma</a>
            <a class="knop knop--rand" href={`/wedstrijd/${wedstrijd.wedstrijdcode}`}>Wedstrijddetails</a>
            <a
              class="knop knop--rand"
              href={routeLink(wedstrijd.accommodatie)}
              target="_blank"
              rel="noopener noreferrer"
            >Route</a>
          </div>
        </div>

        <div class="scorebord-teller">
          <p class="scorebord-tellerkop">Aftrap over</p>
          <Klapbord doel={wedstrijd.datum} />
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .scorebord-binnen { padding-block: clamp(2.25rem, 5vw, 3.75rem); }

  .scorebord-wedstrijd { display: grid; gap: 2rem; align-items: center; }
  .scorebord-wedstrijd[hidden] { display: none; }

  .scorebord-links { display: grid; gap: 1rem; }

  .scorebord-duel {
    display: grid;
    gap: 0.5rem;
    font-size: clamp(1.6rem, 1rem + 3.2vw, 3.25rem);
    line-height: 1;
  }
  .scorebord-club {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }
  .scorebord-club > span { min-width: 0; overflow-wrap: anywhere; }
  .scorebord-tegen {
    font-family: var(--font-smal);
    font-size: var(--text-mini);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-grijs);
    padding-left: calc(52px + 0.85rem);
  }

  .scorebord-wanneer {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    font-family: var(--font-smal);
    font-size: 1.35rem;
    font-weight: 600;
  }
  .scorebord-waar { font-size: var(--text-klein); margin-top: -0.6rem; }

  .scorebord-knoppen { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.5rem; }
  .scorebord-leeg { padding-block: 1.5rem; }

  .scorebord-teller {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    padding: 1.5rem;
    border-radius: var(--radius-vlak);
    background: var(--kleur-inkt);
  }
  .scorebord-tellerkop {
    font-family: var(--font-smal);
    font-size: var(--text-mini);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-blauw);
  }

  @media (min-width: 1000px) {
    .scorebord-wedstrijd {
      grid-template-columns: minmax(0, 1.25fr) auto;
      gap: 3rem;
    }
  }
</style>

<script>
  /**
   * Toon de eerste wedstrijd die nog moet beginnen. Alle kandidaten staan al
   * in de HTML; dit script zet alleen zichtbaarheid om.
   */
  const bord = document.querySelector<HTMLElement>('[data-scorebord]');
  if (bord) {
    const kandidaten = [...bord.querySelectorAll<HTMLElement>('[data-wedstrijd]')];
    const nu = Date.now();
    // Een wedstrijd blijft nog twee uur staan nadat hij begonnen is: dan zie
    // je op zondagmiddag nog steeds waar er gespeeld wordt.
    const marge = 2 * 60 * 60 * 1000;

    const eerstvolgende = kandidaten.find((el) => {
      const aftrap = el.dataset.aftrap;
      return aftrap ? new Date(aftrap).getTime() + marge > nu : false;
    });

    if (eerstvolgende && eerstvolgende !== kandidaten[0]) {
      kandidaten.forEach((el) => el.setAttribute('hidden', ''));
      eerstvolgende.removeAttribute('hidden');
    }
  }
</script>
